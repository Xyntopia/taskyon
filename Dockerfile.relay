# syntax=docker/dockerfile:1.4
FROM node:22-slim AS builder

WORKDIR /app

# set a cache folder
ENV YARN_CACHE_FOLDER=/tmp/.yarn-cache

# Use the Yarn version pinned by packageManager (Yarn 4)
ENV COREPACK_ENABLE_STRICT=1
RUN corepack enable

# copy workspace manifests/sources needed for a consistent immutable install
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages ./packages

# install dependencies with cache mount and then focus to relay-only production deps
RUN --mount=type=cache,target=$YARN_CACHE_FOLDER \
    yarn install --immutable --mode=skip-build && \
    yarn workspace @taskyon/relay build && \
    yarn workspaces focus @taskyon/relay --production

# ---- runtime ----
FROM node:22-slim
WORKDIR /app

# copy relay runtime and focused dependencies
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/relay/dist ./packages/relay/dist

CMD ["node", "packages/relay/dist/relay.mjs"]
