{
  "version": 36,
  "appConfiguration": {
    "darkTheme": "auto",
    "appConfigurationUrl": "/taskyon_settings.json",
    "gdriveConfigurationFile": "taskyon_settings.json",
    "expertMode": false,
    "showCosts": false,
    "gdriveDir": "taskyon",
    "useEnterToSend": "auto",
    "taskSearchVectorizer": "static-multilingual",
    "sandboxFetchTransport": "ask",
    "sandboxFetchWssUrl": "wss://share.taskyon.space/ws-proxy/",
    "sandboxCorsProxyUrl": "/__taskyon_dev_proxy/",
    "pmtilesCacheMaxSizeMb": 1024,
    "guiMode": "auto",
    "primaryColor": "#2A3548",
    "secondaryColor": "#F78F3B"
  },
  "toolchainProfiles": {
    "base": {
      "chatCompletion": {
        "timeouts": {
          "totalMs": 600000,
          "stepMs": 600000
        }
      },
      "taskyonFlow": {
        "use_baseprompt": true,
        "pinnedTools": [
          "read",
          "write",
          "edit",
          "grep",
          "find",
          "ls",
          "executeJavaScript",
          "storage",
          "askClarifyingQuestions"
        ],
        "toolSearchEnabled": true,
        "recentToolCount": 3,
        "frequentToolCount": 3,
        "recentSearchToolCount": 3,
        "max_error_retries": 3,
        "use_multimodal": true,
        "reasoning_effort": "low",
        "websearch": {
          "enabled": true,
          "max_results": 5
        },
        "prompt_templates": {
          "basePrompt": "You are Taskyon, a concise and accurate assistant. Answer directly when no tool is needed. Never write or imitate Taskyon variable HTML comments; reuse only existing variable names.",
          "message": "Complete the request in the requested order.",
          "toolResult": "Continue from the tool result, or answer if done.",
          "error": "Tool error: {error}. Retry with corrected arguments if recoverable; otherwise explain the failure.",
          "retryExhausted": "The tool failed {retryCount} times. Stop retrying and explain the failure."
        }
      },
      "importBrowserMcpTools": {
        "serverUrl": "http://127.0.0.1:8931/mcp",
        "serverName": "local-browser-mcp"
      },
      "ensureBrowserMcpTools": {
        "serverUrl": "http://127.0.0.1:8931/mcp",
        "serverName": "local-browser-mcp",
        "startupInstructions": "Start your browser MCP server manually so it exposes an HTTP MCP endpoint.\nThis can be a local process or a container such as Podman, as long as it binds to the configured MCP URL.\nAfter the endpoint is reachable, click Continue in chat or retry import from the Browser Access page."
      },
      "webResearchPlanner": {
        "researchMode": "websearch-first",
        "supportTools": ["storage", "jinaMarkdownReader"],
        "enableWebSearch": true,
        "webSearchMaxResults": 5,
        "maxSourcesPerQuery": 5,
        "mustDownload": true,
        "fileTypeHints": ["pdf"],
        "deliverable": "manufacturer, product name, source page URL, direct document URL"
      },
      "proxyWebReader": {
        "providerPreset": "scraperapi",
        "providerLabel": "ScraperAPI",
        "docsUrl": "https://docs.scraperapi.com/",
        "pricingUrl": "https://www.scraperapi.com/pricing/",
        "serviceUrl": "https://api.scraperapi.com/",
        "apiKeySecretName": "API_KEY",
        "apiKeyHeader": "",
        "apiKeyScheme": "",
        "apiKeyLocation": "query",
        "apiKeyQueryParam": "api_key",
        "targetUrlParam": "url"
      }
    },
    "profiles": {
      "taskyon": {
        "chatCompletion": {
          "provider": "taskyon",
          "recommendedTransport": "direct",
          "name": "taskyon",
          "model": "z-ai/glm-5.3-flash",
          "baseURL": "https://share.taskyon.space",
          "streamSupport": true,
          "defaultHeaders": {
            "apiKey": "sb_publishable_WrQ1aIRvl9BrMtpMQ9TocQ_JN7I9kJm",
            "HTTP-Referer": "https://taskyon.space",
            "X-Title": "Taskyon"
          },
          "routes": {
            "chatCompletion": "/chatCompletion/api/v1/",
            "models": "/chatCompletion/api/v1/models"
          }
        }
      },
      "huggingface.co": {
        "chatCompletion": {
          "provider": "huggingface.co",
          "recommendedTransport": "direct",
          "name": "huggingface.co",
          "model": "meta-llama/llama-3.3-70b-instruct",
          "baseURL": "https://router.huggingface.co",
          "streamSupport": true,
          "routes": {
            "chatCompletion": "/v1",
            "models": "https://huggingface.co/api/models"
          }
        }
      },
      "openai": {
        "chatCompletion": {
          "provider": "openai",
          "recommendedTransport": "direct",
          "name": "openai",
          "model": "gpt-5.1",
          "baseURL": "https://api.openai.com",
          "streamSupport": true,
          "routes": {
            "chatCompletion": "/v1/",
            "models": "/v1/models"
          }
        }
      },
      "chatgpt-codex": {
        "chatCompletion": {
          "provider": "chatgpt-codex",
          "recommendedTransport": "wss",
          "name": "chatgpt-codex",
          "model": "gpt-5.4",
          "baseURL": "https://chatgpt.com/backend-api/codex",
          "streamSupport": true,
          "auth": {
            "type": "oauth",
            "oauth": {
              "authorizationUrl": "https://auth.openai.com/oauth/authorize",
              "tokenUrl": "https://auth.openai.com/oauth/token",
              "clientId": "app_EMoamEEZ73f0CkXaXp7hrann",
              "scope": "openid profile email offline_access",
              "authorizeQuery": {
                "id_token_add_organizations": "true",
                "codex_cli_simplified_flow": "true"
              }
            }
          },
          "routes": {
            "chatCompletion": "/responses",
            "models": "/models"
          }
        }
      },
      "openrouter.ai": {
        "chatCompletion": {
          "provider": "openrouter.ai",
          "recommendedTransport": "direct",
          "name": "openrouter.ai",
          "model": "google/gemini-2.5-flash-lite",
          "baseURL": "https://openrouter.ai",
          "streamSupport": true,
          "defaultHeaders": {
            "HTTP-Referer": "https://taskyon.space",
            "X-Title": "Taskyon"
          },
          "routes": {
            "chatCompletion": "/api/v1/",
            "models": "/api/v1/models"
          }
        }
      },
      "local": {
        "chatCompletion": {
          "provider": "local",
          "recommendedTransport": "direct",
          "name": "local LLM server",
          "model": "qwen3-4b",
          "baseURL": "http://localhost:8080",
          "streamSupport": true,
          "routes": {
            "chatCompletion": "/v1/",
            "models": "/v1/models"
          }
        }
      }
    }
  },
  "selectedToolchainProfile": "taskyon",
  "llmSettings": {
    "entryFunction": "taskyonFlow",
    "taskWorker": {
      "maxConcurrency": 4
    }
  }
}
