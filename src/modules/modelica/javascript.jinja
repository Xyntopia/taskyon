{# -------------------------------------------------------------------------
 # JS generator for rumoca DAE JSON (implicit form) with basic event handling
 #
 # Model() returns:
 #   - name
 #   - meta: {
 #       name,
 #       parameters, constants,
 #       states, algebraics, inputs, conditions,
 #       summary
 #     }
 #   - x0, y0, c0
 #   - residual(t, x, xDot, y, u, pOverride) -> residual vector
 #   - evalConditions(t, x, y, u, pOverride) -> [c_i] boolean array
 #   - applyResets(t, x, y, u, pOverride, cPrev, cCurr)
 #       -> { x: xNew, y: yNew, c: cNew }
 #
 # Residual ordering:
 #   - First: all state derivative equations (der(x) = ...)
 #   - Then: all other equations (typically for algebraics)
 #   - Then: zeros for unsupported forms (to preserve length)
 #
 # Solver-side wrapper may assume:
 #   res[i]        = xDot[i] - f_i(t,x,y,u,p)
 #   res[nx + j]   = y[j]    - g_j(t,x,u,p)
 # ------------------------------------------------------------------------- #}

{%- macro render_cref(cr) -%}
{%- for part in cr.parts -%}
{{ part.ident.text }}{{ "." if not loop.last }}
{%- endfor -%}
{%- endmacro -%}

{%- macro render_expr(e) -%}
{%- if e is string -%}
  {%- if e == "Empty" -%}0{%- else -%}0{%- endif -%}
{%- elif "Terminal" in e -%}
  {{- e.Terminal.token.text -}}
{%- elif "ComponentReference" in e -%}
  {{- render_cref(e.ComponentReference) -}}
{%- elif "Parenthesized" in e -%}
  ({{ render_expr(e.Parenthesized.inner) }})
{%- elif "Unary" in e -%}
  {%- set u = e.Unary -%}
  {%- if "Minus" in u.op -%}
    -({{ render_expr(u.rhs) }})
  {%- elif "Not" in u.op -%}
    !({{ render_expr(u.rhs) }})
  {%- else -%}
    0
  {%- endif -%}
{%- elif "Binary" in e -%}
  {%- set b = e.Binary -%}
  {%- set op -%}
    {%- if "Add" in b.op -%}+{%-
    elif "Sub" in b.op -%}-{%-
    elif "Mul" in b.op -%}*{%-
    elif "Div" in b.op -%}/{%-
    elif "Pow" in b.op -%}**{%-

    elif "Le" in b.op or "LessEq" in b.op -%}<={%-
    elif "Lt" in b.op or "Less" in b.op -%}<{%-
    elif "Ge" in b.op or "GreaterEq" in b.op -%}>={%-
    elif "Gt" in b.op or "Greater" in b.op -%}>{%-
    elif "Eq" in b.op or "Equals" in b.op -%}==={%-
    elif "Ne" in b.op or "NotEquals" in b.op -%}!=={%-

    elif "And" in b.op -%}&&{%-
    elif "Or" in b.op -%}||{%-
    else -%}+{%-
    endif -%}
  {%- endset -%}
  ({{ render_expr(b.lhs) }} {{ op }} {{ render_expr(b.rhs) }})
{%- elif "FunctionCall" in e -%}
  {%- set f = e.FunctionCall -%}
  {%- set fname -%}{%- for part in f.comp.parts -%}{{ part.ident.text }}{{ "." if not loop.last }}{%- endfor -%}{%- endset -%}

  {%- if fname == "der" and f.args|length == 1 -%}
    der_{{ render_expr(f.args[0]) }}
  {%- elif fname == "pre" and f.args|length == 1 -%}
    {{ render_expr(f.args[0]) }}
  {%- else -%}
    {%- set jsname = fname -%}
    {%- if fname in ["sin","cos","tan","asin","acos","atan","atan2","sinh","cosh","tanh","exp","log","log10","sqrt","abs","floor","ceil","min","max"] -%}
      {%- set jsname = "Math." ~ fname -%}
    {%- endif -%}
    {{ jsname }}({%- for a in f.args -%}{{ render_expr(a) }}{{ ", " if not loop.last }}{%- endfor -%})
  {%- endif -%}
{%- else -%}
  0
{%- endif -%}
{%- endmacro -%}

{%- macro is_derivative_eq(eq) -%}
  {%- if "Simple" in eq and "FunctionCall" in eq.Simple.lhs -%}
    {%- set f = eq.Simple.lhs.FunctionCall -%}
    {%- if f.comp.parts|length == 1 and f.comp.parts[0].ident.text == "der" -%}
      1
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro lhs_state_name(eq) -%}
  {# extract state name from der(state) = ... #}
  {%- set f = eq.Simple.lhs.FunctionCall -%}
  {%- set cr = f.args[0].ComponentReference -%}
  {{ cr.parts[0].ident.text }}
{%- endmacro -%}

/**
 * Generated Modelica DAE model: {{ dae.model_name or "GeneratedModel" }}
 *
 * Parameters:
{%- for (name, comp) in dae.p|items %}
 *   {{ name }} = {{ render_expr(comp.start) }}
{%- endfor %}
 *
 * Constants:
{%- for (name, comp) in dae.cp|items %}
 *   {{ name }} = {{ render_expr(comp.start) }}
{%- endfor %}
 *
 * States (x):
{%- for (name, comp) in dae.x|items %}
 *   {{ name }} = {{ render_expr(comp.start) }}
{%- endfor %}
 *
 * Algebraics (y):
{%- for (name, comp) in dae.y|items %}
 *   {{ name }} = {{ render_expr(comp.start) }}
{%- endfor %}
 *
 * Conditions (c):
{%- for (name, comp) in dae.c|items %}
 *   {{ name }} = {{ render_expr(comp.start) if comp.start is defined else "false" }}
{%- endfor %}
 *
 * Equations (fx):
{%- for eq in dae.fx %}
  {%- if "Simple" in eq and is_derivative_eq(eq) %}
 *   der({{ lhs_state_name(eq) }}) = {{ render_expr(eq.Simple.rhs) }};
  {%- elif "Simple" in eq %}
 *   {{ render_expr(eq.Simple.lhs) }} = {{ render_expr(eq.Simple.rhs) }};
  {%- else %}
 *   /* unsupported equation: {{ eq|tojson }} */
  {%- endif %}
{%- endfor %}
 *
 * When-conditions (fc):
{%- for (name, cond) in dae.fc|items %}
 *   {{ name }} : {{ render_expr(cond) }}
{%- endfor %}
 *
 * Reset rules (fr):
{%- for (name, rule) in dae.fr|items %}
  {%- if "Assignment" in rule %}
    {%- set a = rule.Assignment %}
 *   when {{ name }} then {{ render_expr(a.comp) }} := {{ render_expr(a.value) }};
  {%- else %}
 *   when {{ name }} then /* unsupported reset form: {{ rule|tojson }} */
  {%- endif %}
{%- endfor %}
 */
function Model() {
  /* --- metadata ----------------------------------------------------------- */

  const meta = {
    name: "{{ dae.model_name or "GeneratedModel" }}",

    parameters: [
    {%- for (name, comp) in dae.p|items %}
      { name: "{{ name }}", start: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
    {%- endfor %}
    ],

    constants: [
    {%- for (name, comp) in dae.cp|items %}
      { name: "{{ name }}", value: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
    {%- endfor %}
    ],

    states: [
    {%- for (name, comp) in dae.x|items %}
      { name: "{{ name }}", start: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
    {%- endfor %}
    ],

    algebraics: [
    {%- for (name, comp) in dae.y|items %}
      { name: "{{ name }}", start: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
    {%- endfor %}
    ],

    inputs: [
    {%- for (name, comp) in dae.u|items %}
      { name: "{{ name }}" }{% if not loop.last %},{% endif %}
    {%- endfor %}
    ],

    conditions: [
    {%- for (name, comp) in dae.c|items %}
      { name: "{{ name }}", start: {{ render_expr(comp.start) if comp.start is defined else "false" }} }{% if not loop.last %},{% endif %}
    {%- endfor %}
    ],

    summary: {
      nx: {{ dae.x|length }},
      ny: {{ dae.y|length }},
      nc: {{ dae.c|length }},
      neqs: {{ dae.fx|length }}
    }
  };

  /* convenient initial vectors */
  const x0 = meta.states.map(s => s.start);
  const y0 = meta.algebraics.map(a => a.start);
  const c0 = meta.conditions.map(c => c.start);

  /* parameter defaults (object) */
  const pDefaults = {
  {%- for (name, comp) in dae.p|items %}
    {{ name }}: {{ render_expr(comp.start) }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  };

  /* constants as a simple object */
  const constants = {
  {%- for (name, comp) in dae.cp|items %}
    {{ name }}: {{ render_expr(comp.start) }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  };

  /* index maps for convenience in events / resets */
  const stateIndex = {
  {%- for (name, comp) in dae.x|items %}
    "{{ name }}": {{ loop.index0 }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  };

  const algebraicIndex = {
  {%- for (name, comp) in dae.y|items %}
    "{{ name }}": {{ loop.index0 }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  };

  const conditionIndex = {
  {%- for (name, comp) in dae.c|items %}
    "{{ name }}": {{ loop.index0 }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  };

  /**
   * Residual function:
   *   F(t, x, xDot, y, u, pOverride) = 0
   *
   * @param {number}   t      time
   * @param {number[]} x      state vector
   * @param {number[]} xDot   state derivative (chosen by solver)
   * @param {number[]} y      algebraic variables
   * @param {number[]} u      inputs
   * @param {object}   pOverride parameter overrides
   *
   * @returns {number[]} residual vector of length (nx + ny)
   *
   * Ordering:
   *   - First: residuals for all state derivatives (der(x) = ...)
   *   - Then: residuals for other equations (typically algebraics)
   */
  function residual(t, x, xDot, y, u, pOverride) {
    const p = Object.assign({}, pDefaults, pOverride || {});

    /* unpack parameters */
  {%- for (name, comp) in dae.p|items %}
    const {{ name }} = p.{{ name }};
  {%- endfor %}

    /* unpack constants */
  {%- for (name, comp) in dae.cp|items %}
    const {{ name }} = constants.{{ name }};
  {%- endfor %}

    /* unpack states */
  {%- for (name, comp) in dae.x|items %}
    const {{ name }} = x[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack xDot */
  {%- for (name, comp) in dae.x|items %}
    const {{ name }}_dot = xDot[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack algebraics */
  {%- for (name, comp) in dae.y|items %}
    const {{ name }} = y[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack inputs */
  {%- for (name, comp) in dae.u|items %}
    const {{ name }} = u[{{ loop.index0 }}];
  {%- endfor %}

    /* residuals: derivative equations first, then others */
    {%- set res = namespace(first=true) %}
    return [
    {# -- 1) derivative equations: der(x) = ... -------------------------- #}
    {%- for eq in dae.fx %}
      {%- if "Simple" in eq and is_derivative_eq(eq) %}
        {%- if not res.first %},{% endif %}
        // der({{ lhs_state_name(eq) }}) = {{ render_expr(eq.Simple.rhs) }}
        {{ lhs_state_name(eq) }}_dot - ({{ render_expr(eq.Simple.rhs) }})
        {%- set res.first = false %}
      {%- endif %}
    {%- endfor %}

    {# -- 2) other simple equations: lhs = rhs (typically algebraics) ----- #}
    {%- for eq in dae.fx %}
      {%- if "Simple" in eq and not is_derivative_eq(eq) %}
        {%- if not res.first %},{% endif %}
        // {{ render_expr(eq.Simple.lhs) }} = {{ render_expr(eq.Simple.rhs) }}
        ({{ render_expr(eq.Simple.lhs) }}) - ({{ render_expr(eq.Simple.rhs) }})
        {%- set res.first = false %}
      {%- endif %}
    {%- endfor %}

    {# -- 3) unsupported equations: fill with 0 to preserve length -------- #}
    {%- for eq in dae.fx %}
      {%- if "Simple" not in eq %}
        {%- if not res.first %},{% endif %}
        0 /* unsupported equation form: {{ eq|tojson }} */
        {%- set res.first = false %}
      {%- endif %}
    {%- endfor %}
    ];
  }

  /**
   * Evaluate condition booleans c_i = fc_i(t, x, y, u, p).
   * Used for when / reinit event detection.
   */
  function evalConditions(t, x, y, u, pOverride) {
    const p = Object.assign({}, pDefaults, pOverride || {});

    /* unpack parameters */
  {%- for (name, comp) in dae.p|items %}
    const {{ name }} = p.{{ name }};
  {%- endfor %}

    /* unpack constants */
  {%- for (name, comp) in dae.cp|items %}
    const {{ name }} = constants.{{ name }};
  {%- endfor %}

    /* unpack states (pre-event) */
  {%- for (name, comp) in dae.x|items %}
    const {{ name }} = x[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack algebraics (pre-event) */
  {%- for (name, comp) in dae.y|items %}
    const {{ name }} = y[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack inputs */
  {%- for (name, comp) in dae.u|items %}
    const {{ name }} = u[{{ loop.index0 }}];
  {%- endfor %}

    return [
    {%- for (name, comp) in dae.c|items %}
      {%- if dae.fc is defined and (name in dae.fc) -%}
        {{ render_expr(dae.fc[name]) }}
      {%- else -%}
        {{ render_expr(comp.start) if comp.start is defined else "false" }}
      {%- endif -%}
      {%- if not loop.last %},{% endif %}
    {%- endfor %}
    ];
  }

  /**
   * Apply reset rules for events that fired between cPrev and cCurr.
   *
   * - x, y are pre-event values at the event time.
   * - cPrev, cCurr are boolean arrays.
   * - Returns new { x, y, c } after applying resets.
   */
  function applyResets(t, x, y, u, pOverride, cPrev, cCurr) {
    const p = Object.assign({}, pDefaults, pOverride || {});

    /* unpack parameters (pre-event) */
  {%- for (name, comp) in dae.p|items %}
    const {{ name }} = p.{{ name }};
  {%- endfor %}

    /* unpack constants (pre-event) */
  {%- for (name, comp) in dae.cp|items %}
    const {{ name }} = constants.{{ name }};
  {%- endfor %}

    /* unpack states (pre-event) */
  {%- for (name, comp) in dae.x|items %}
    const {{ name }} = x[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack algebraics (pre-event) */
  {%- for (name, comp) in dae.y|items %}
    const {{ name }} = y[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack inputs */
  {%- for (name, comp) in dae.u|items %}
    const {{ name }} = u[{{ loop.index0 }}];
  {%- endfor %}

    let xNew = x.slice();
    let yNew = y.slice();
    let cNew = Array.isArray(cCurr) ? cCurr.slice() : [];

  {%- for (cname, ccomp) in dae.c|items %}
    {
      const idx = conditionIndex["{{ cname }}"];
      const fired = !cPrev[idx] && cCurr[idx];

      if (fired) {
        // when {{ cname }} fires, apply associated reset(s)
        {%- if dae.fr is defined and (cname in dae.fr) %}
          {%- set r = dae.fr[cname] %}
          {%- if "Assignment" in r %}
            {%- set a = r.Assignment %}
            {%- set target = a.comp.parts[0].ident.text %}
            {%- if target in dae.x %}
        // Reset state {{ target }}
        xNew[stateIndex["{{ target }}"]] = {{ render_expr(a.value) }};
            {%- elif target in dae.y %}
        // Reset algebraic {{ target }}
        yNew[algebraicIndex["{{ target }}"]] = {{ render_expr(a.value) }};
            {%- else %}
        // Unsupported reset target {{ target }} (only states/algebraics supported)
            {%- endif %}
          {%- else %}
        // Unsupported reset form for condition {{ cname }}
          {%- endif %}
        {%- else %}
        // No reset rule defined for condition {{ cname }}
        {%- endif %}
      }
    }
  {%- endfor %}

    return { x: xNew, y: yNew, c: cNew };
  }

  // --- Taskyon minimal ABI declaration (optional, but recommended) ----------
  // The editor can validate this ABI at compile-time.
  // A custom template can omit this entirely to opt-out.
  const abiRequired = true;
  const abi = { id: 'taskyon.model_runtime.residual.v1', version: 1 };
  const description = {
    modelName: meta.name,
    variables: []
      .concat(meta.parameters.map((v) => ({ name: v.name, kind: 'parameter', start: v.start })))
      .concat(meta.constants.map((v) => ({ name: v.name, kind: 'constant', start: v.value })))
      .concat(meta.states.map((v) => ({ name: v.name, kind: 'state', start: v.start })))
      .concat(meta.algebraics.map((v) => ({ name: v.name, kind: 'algebraic', start: v.start })))
      .concat(meta.inputs.map((v) => ({ name: v.name, kind: 'input' }))),
    nx: meta.summary.nx,
    ny: meta.summary.ny,
    nu: meta.inputs.length,
    // Reserved for FMI-like event indicators in the future
    nz: 0
  };
  const capabilities = { events: false };

  return {
    abiRequired,
    abi,
    description,
    capabilities,
    name: meta.name,
    meta,
    x0,
    y0,
    c0,
    residual,
    evalConditions,
    applyResets
  };
}
