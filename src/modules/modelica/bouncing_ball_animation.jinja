{# -------------------------------------------------------------------------
 # Standalone HTML generator
 #
 # Produces a single self-contained HTML file that embeds:
 #  - Generated Model() JS for the compiled DAE
 #  - A JS solver (copied from simulateModel.js)
 #  - A small UI to run simulations, define input signals, plot, and download CSV
 #
 # Notes
 #  - No external files required.
 #  - No external CSS required.
 #  - External JS libraries are NOT used by default (keeps file:// friendly).
 # ------------------------------------------------------------------------- #}

{%- macro render_expr(e) -%}
  {%- if e is string and e == "Empty" -%}
    0
  {%- elif "parts" in e -%}
    {% for part in e.parts %}
      {{ part.ident.text }}{{ "." if not loop.last }}
    {%- endfor -%}
  {%- elif "Terminal" in e -%}
    {{ e.Terminal.token.text }}
  {%- elif "ComponentReference" in e -%}
    {%- set cr = e.ComponentReference -%}
    {%- for part in cr.parts -%}
      {{ part.ident.text }}{{ "." if not loop.last }}
    {%- endfor -%}
  {%- elif "Unary" in e -%}
    {%- set u = e.Unary -%}
    {%- if "Minus" in u.op -%}
      -({{ render_expr(u.rhs) }})
    {%- elif "Not" in u.op -%}
      !({{ render_expr(u.rhs) }})
    {%- else -%}
      (0)
    {%- endif -%}
  {%- elif "Binary" in e -%}
    {%- set b = e.Binary -%}
    {%- set op -%}
      {%- if "Add" in b.op -%}+{%-
      elif "Sub" in b.op -%}-{%-
      elif "Mul" in b.op -%}*{%-
      elif "Div" in b.op -%}/{%-
      elif "Pow" in b.op -%}**{%-

      elif "Le" in b.op or "LessEq" in b.op -%}<={%-
      elif "Lt" in b.op or "Less" in b.op -%}<{%-
      elif "Ge" in b.op or "GreaterEq" in b.op -%}>={%-
      elif "Gt" in b.op or "Greater" in b.op -%}>{%-
      elif "Eq" in b.op or "Equals" in b.op -%}==={%-
      elif "Ne" in b.op or "NotEquals" in b.op -%}!=={%-

      elif "And" in b.op -%}&&{%-
      elif "Or" in b.op -%}||{%-
      else -%}?{%-
      endif -%}
    {%- endset -%}
    ({{ render_expr(b.lhs) }} {{ op }} {{ render_expr(b.rhs) }})
  {%- elif "FunctionCall" in e -%}
    {%- set f = e.FunctionCall -%}
    {%- set name = f.comp.parts[0].ident.text -%}
    {%- if name == "der" and f.args|length == 1 and "ComponentReference" in f.args[0] -%}
      der_{{ render_expr(f.args[0]) }}
    {%- elif name == "pre" and f.args|length == 1 and "ComponentReference" in f.args[0] -%}
      {{ render_expr(f.args[0]) }}
    {%- else -%}
      {{ name }}(
      {%- for a in f.args -%}
        {{ render_expr(a) }}{{ ", " if not loop.last }}
      {%- endfor -%}
      )
    {%- endif -%}
  {%- else -%}
    0
  {%- endif -%}
{%- endmacro -%}

{%- macro is_derivative_eq(eq) -%}
  {%- if "Simple" in eq and "FunctionCall" in eq.Simple.lhs -%}
    {%- set f = eq.Simple.lhs.FunctionCall -%}
    {%- if f.comp.parts|length == 1 and f.comp.parts[0].ident.text == "der" -%}
      1
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro lhs_state_name(eq) -%}
  {%- set f = eq.Simple.lhs.FunctionCall -%}
  {%- set cr = f.args[0].ComponentReference -%}
  {{ cr.parts[0].ident.text }}
{%- endmacro -%}

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Rumoca Standalone Simulation</title>
    <style>
      :root {
        --bg: #0b0f17;
        --panel: #121a26;
        --panel2: #0f1622;
        --text: #e7eefc;
        --muted: #9bb0d1;
        --accent: #6aa6ff;
        --bad: #ff6a6a;
        --good: #7dffb2;
        --border: #24324a;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, "Noto Sans", "Liberation Sans", sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: linear-gradient(180deg, var(--panel), var(--panel2));
      }
      header .title {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.2px;
      }
      header .subtitle {
        font-size: 12px;
        color: var(--muted);
        margin-top: 4px;
      }
      main {
        padding: 12px 16px;
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 12px;
      }
      @media (max-width: 980px) {
        main { grid-template-columns: 1fr; }
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px;
      }
      .row {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
      }
      label {
        font-size: 12px;
        color: var(--muted);
      }
      input, select, textarea, button {
        font: inherit;
      }
      input, select, button {
        min-height: 36px;
      }

      input, select, textarea {
        background: #0d1420;
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        padding: 8px 10px;
        outline: none;
      }
      input:focus, select:focus, textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px rgba(106,166,255,0.15);
      }
      textarea {
        width: 100%;
        min-height: 140px;
        resize: vertical;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 12px;
        line-height: 1.3;
      }
      button {
        -webkit-appearance: none;
        appearance: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--accent);
        border: 1px solid rgba(255,255,255,0.08);
        color: #05101f;
        border-radius: 8px;
        padding: 8px 10px;
        margin: 0;
        cursor: pointer;
        font-weight: 700;
        line-height: 1;
        vertical-align: middle;
      }
      button.secondary {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
      }
      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .hint {
        font-size: 12px;
        color: var(--muted);
        margin-top: 6px;
      }
      .status {
        font-size: 12px;
        white-space: pre-wrap;
        color: var(--muted);
      }
      .status.good { color: var(--good); }
      .status.bad { color: var(--bad); }
      .plotWrap {
        width: 100%;
        overflow: hidden;
      }
      svg {
        width: 100%;
        height: 420px;
        display: block;
        background: #0b1220;
        border: 1px solid var(--border);
        border-radius: 10px;
      }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
      .small { font-size: 12px; }
      .kv {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 6px 10px;
        margin-top: 8px;
        font-size: 12px;
      }
      .kv div.key { color: var(--muted); }
      .kv div.val { color: var(--text); }
    </style>
  </head>
  <body>
    <header>
      <div class="title">Rumoca Standalone Simulation</div>
      <div class="subtitle mono">Model: {{ dae.model_name or "GeneratedModel" }}</div>
    </header>

    <main>
      <section class="card">
        <div class="row">
          <div style="flex: 1 1 80px;">
            <label for="t0">t0</label>
            <input id="t0" type="number" step="any" value="0" style="width:100%" />
          </div>
          <div style="flex: 1 1 80px;">
            <label for="tf">tf</label>
            <input id="tf" type="number" step="any" value="5" style="width:100%" />
          </div>
          <div style="flex: 1 1 80px;">
            <label for="dt">dt</label>
            <input id="dt" type="number" step="any" value="0.1" style="width:100%" />
          </div>
        </div>

        <div style="margin-top: 10px;">
          <label for="inputFn">Input function body</label>
          <textarea id="inputFn" spellcheck="false">// Called as f_u(t)
// Return an array matching the model input order
// Example for 1 input: return [Math.sin(t)]

return [];</textarea>
          <div class="hint">
            The function is compiled as <span class="mono">new Function('t', BODY)</span>.
            It must return an array of length <span class="mono" id="nuCount">0</span>.
          </div>
        </div>

        <div class="row" style="margin-top: 10px;">
          <button id="runBtn">Run simulation</button>
          <button id="csvBtn" class="secondary" disabled>Download CSV</button>
        </div>

        <div style="margin-top: 10px;">
          <div class="status" id="status">Ready.</div>
          <div class="kv" id="summary"></div>
        </div>

        <div style="margin-top: 12px;">
          <label for="seriesSelect">Plot series</label>
          <select id="seriesSelect" style="width: 100%;"></select>
          <div class="hint">Plots time versus selected series using a simple SVG polyline.</div>
        </div>
      </section>

      <section class="card">
        <div class="plotWrap">
          <svg id="plot" viewBox="0 0 1000 420" preserveAspectRatio="none" role="img" aria-label="plot">
            <rect x="0" y="0" width="1000" height="420" fill="#0b1220"></rect>
            <g id="grid"></g>
            <line id="groundLine" x1="0" y1="380" x2="1000" y2="380" stroke="#1f2b40" stroke-width="2"></line>
            <circle id="ball" cx="60" cy="80" r="18" fill="#7dffb2" stroke="#0b1220" stroke-width="2"></circle>
            <polyline id="line" fill="none" stroke="#6aa6ff" stroke-width="2" points=""></polyline>
            <text id="plotLabel" x="12" y="22" fill="#9bb0d1" font-size="14" font-family="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace"></text>
            <text id="plotRange" x="12" y="42" fill="#9bb0d1" font-size="12" font-family="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace"></text>
          </svg>
        </div>
        <div class="hint small">
          For large simulations, CSV generation may take a bit in the browser.
        </div>
      </section>
    </main>

    <script>
      "use strict";

      /* ---------------------------------------------------------------------
       * Generated model code (same as javascript.jinja)
       * -------------------------------------------------------------------*/

      function Model() {
        /* --- metadata ----------------------------------------------------- */

        const meta = {
          name: "{{ dae.model_name or "GeneratedModel" }}",

          parameters: [
          {%- for (name, comp) in dae.p|items %}
            { name: "{{ name }}", start: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
          {%- endfor %}
          ],

          constants: [
          {%- for (name, comp) in dae.cp|items %}
            { name: "{{ name }}", value: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
          {%- endfor %}
          ],

          states: [
          {%- for (name, comp) in dae.x|items %}
            { name: "{{ name }}", start: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
          {%- endfor %}
          ],

          algebraics: [
          {%- for (name, comp) in dae.y|items %}
            { name: "{{ name }}", start: {{ render_expr(comp.start) }} }{% if not loop.last %},{% endif %}
          {%- endfor %}
          ],

          inputs: [
          {%- for (name, comp) in dae.u|items %}
            { name: "{{ name }}" }{% if not loop.last %},{% endif %}
          {%- endfor %}
          ],

          conditions: [
          {%- for (name, comp) in dae.c|items %}
            { name: "{{ name }}", start: {{ render_expr(comp.start) if comp.start is defined else "false" }} }{% if not loop.last %},{% endif %}
          {%- endfor %}
          ],

          summary: {
            nx: {{ dae.x|length }},
            ny: {{ dae.y|length }},
            nc: {{ dae.c|length }},
            neqs: {{ dae.fx|length }}
          }
        };

        /* convenient initial vectors */
        const x0 = meta.states.map(s => s.start);
        const y0 = meta.algebraics.map(a => a.start);
        const c0 = meta.conditions.map(c => c.start);

        /* parameter defaults */
        const pDefaults = {
        {%- for (name, comp) in dae.p|items %}
          {{ name }}: {{ render_expr(comp.start) }}{% if not loop.last %},{% endif %}
        {%- endfor %}
        };

        /* constants */
        const constants = {
        {%- for (name, comp) in dae.cp|items %}
          {{ name }}: {{ render_expr(comp.start) }}{% if not loop.last %},{% endif %}
        {%- endfor %}
        };

        /* index maps */
        const stateIndex = {
        {%- for (name, comp) in dae.x|items %}
          "{{ name }}": {{ loop.index0 }}{% if not loop.last %},{% endif %}
        {%- endfor %}
        };

        const algebraicIndex = {
        {%- for (name, comp) in dae.y|items %}
          "{{ name }}": {{ loop.index0 }}{% if not loop.last %},{% endif %}
        {%- endfor %}
        };

        const conditionIndex = {
        {%- for (name, comp) in dae.c|items %}
          "{{ name }}": {{ loop.index0 }}{% if not loop.last %},{% endif %}
        {%- endfor %}
        };

        function residual(t, x, xDot, y, u, pOverride) {
          const p = Object.assign({}, pDefaults, pOverride || {});

          /* unpack parameters */
        {%- for (name, comp) in dae.p|items %}
          const {{ name }} = p.{{ name }};
        {%- endfor %}

          /* unpack constants */
        {%- for (name, comp) in dae.cp|items %}
          const {{ name }} = constants.{{ name }};
        {%- endfor %}

          /* unpack states */
        {%- for (name, comp) in dae.x|items %}
          const {{ name }} = x[{{ loop.index0 }}];
        {%- endfor %}

          /* unpack xDot */
        {%- for (name, comp) in dae.x|items %}
          const {{ name }}_dot = xDot[{{ loop.index0 }}];
        {%- endfor %}

          /* unpack algebraics */
        {%- for (name, comp) in dae.y|items %}
          const {{ name }} = y[{{ loop.index0 }}];
        {%- endfor %}

          /* unpack inputs */
        {%- for (name, comp) in dae.u|items %}
          const {{ name }} = u[{{ loop.index0 }}];
        {%- endfor %}

          /* residual ordering: derivative eqs first, then others */
          {%- set res = namespace(first=true) %}
          return [
          {%- for eq in dae.fx %}
            {%- if "Simple" in eq and is_derivative_eq(eq) %}
              {%- if not res.first %},{% endif %}
              {{ lhs_state_name(eq) }}_dot - ({{ render_expr(eq.Simple.rhs) }})
              {%- set res.first = false %}
            {%- endif %}
          {%- endfor %}

          {%- for eq in dae.fx %}
            {%- if "Simple" in eq and not is_derivative_eq(eq) %}
              {%- if not res.first %},{% endif %}
              ({{ render_expr(eq.Simple.lhs) }}) - ({{ render_expr(eq.Simple.rhs) }})
              {%- set res.first = false %}
            {%- endif %}
          {%- endfor %}

          {%- for eq in dae.fx %}
            {%- if "Simple" not in eq %}
              {%- if not res.first %},{% endif %}
              0
              {%- set res.first = false %}
            {%- endif %}
          {%- endfor %}
          ];
        }

        function evalConditions(t, x, y, u, pOverride) {
          const p = Object.assign({}, pDefaults, pOverride || {});

          /* unpack parameters */
        {%- for (name, comp) in dae.p|items %}
          const {{ name }} = p.{{ name }};
        {%- endfor %}

          /* unpack constants */
        {%- for (name, comp) in dae.cp|items %}
          const {{ name }} = constants.{{ name }};
        {%- endfor %}

          /* unpack states */
        {%- for (name, comp) in dae.x|items %}
          const {{ name }} = x[{{ loop.index0 }}];
        {%- endfor %}

          /* unpack algebraics */
        {%- for (name, comp) in dae.y|items %}
          const {{ name }} = y[{{ loop.index0 }}];
        {%- endfor %}

          /* unpack inputs */
        {%- for (name, comp) in dae.u|items %}
          const {{ name }} = u[{{ loop.index0 }}];
        {%- endfor %}

          return [
          {%- for (name, comp) in dae.c|items %}
            {%- if dae.fc is defined and (name in dae.fc) -%}
              {{ render_expr(dae.fc[name]) }}
            {%- else -%}
              {{ render_expr(comp.start) if comp.start is defined else "false" }}
            {%- endif -%}
            {%- if not loop.last %},{% endif %}
          {%- endfor %}
          ];
        }

        function applyResets(t, x, y, u, pOverride, cPrev, cCurr) {
          const p = Object.assign({}, pDefaults, pOverride || {});

          /* unpack parameters */
        {%- for (name, comp) in dae.p|items %}
          const {{ name }} = p.{{ name }};
        {%- endfor %}

          /* unpack constants */
        {%- for (name, comp) in dae.cp|items %}
          const {{ name }} = constants.{{ name }};
        {%- endfor %}

          /* unpack states */
        {%- for (name, comp) in dae.x|items %}
          const {{ name }} = x[{{ loop.index0 }}];
        {%- endfor %}

          /* unpack algebraics */
        {%- for (name, comp) in dae.y|items %}
          const {{ name }} = y[{{ loop.index0 }}];
        {%- endfor %}

          /* unpack inputs */
        {%- for (name, comp) in dae.u|items %}
          const {{ name }} = u[{{ loop.index0 }}];
        {%- endfor %}

          let xNew = x.slice();
          let yNew = y.slice();
          let cNew = Array.isArray(cCurr) ? cCurr.slice() : [];

        {%- for (cname, ccomp) in dae.c|items %}
          {
            const idx = conditionIndex["{{ cname }}"];
            const fired = !cPrev[idx] && cCurr[idx];

            if (fired) {
              {%- if dae.fr is defined and (cname in dae.fr) %}
                {%- set r = dae.fr[cname] %}
                {%- if "Assignment" in r %}
                  {%- set a = r.Assignment %}
                  {%- set target = a.comp.parts[0].ident.text %}
                  {%- if target in dae.x %}
              xNew[stateIndex["{{ target }}"]] = {{ render_expr(a.value) }};
                  {%- elif target in dae.y %}
              yNew[algebraicIndex["{{ target }}"]] = {{ render_expr(a.value) }};
                  {%- endif %}
                {%- endif %}
              {%- endif %}
            }
          }
        {%- endfor %}

          return { x: xNew, y: yNew, c: cNew };
        }

        return {
          name: meta.name,
          meta,
          x0,
          y0,
          c0,
          residual,
          evalConditions,
          applyResets
        };
      }

      /* ---------------------------------------------------------------------
       * Solver code (copied from simulateModel.js)
       * -------------------------------------------------------------------*/

      // eslint-disable-next-line no-unused-vars
      const simulateModel = (params, context, model) => {
        const meta = model.meta || {};

        const stateNames = (meta.states || []).map((s) => s.name);
        const algebraicNames = (meta.algebraics || []).map((a) => a.name);
        const inputNames = (meta.inputs || []).map((u) => u.name);
        const conditionNames = (meta.conditions || []).map((c) => c.name);

        const nx = Array.isArray(model.x0) ? model.x0.length : 0;
        const ny = Array.isArray(model.y0) ? model.y0.length : 0;
        const nu = inputNames.length;

        const haveEvents =
          typeof model.evalConditions === 'function' && typeof model.applyResets === 'function';

        const x0_model = Array.isArray(model.x0) ? model.x0.slice() : new Array(nx).fill(0);
        const y0_model = Array.isArray(model.y0) ? model.y0.slice() : new Array(ny).fill(0);

        let c0 = Array.isArray(model.c0) ? model.c0.slice() : null;
        if (!c0 && haveEvents) {
          try {
            const cProbe = model.evalConditions(0, x0_model, y0_model, new Array(nu).fill(0), null);
            if (Array.isArray(cProbe)) c0 = cProbe.slice();
          } catch {
            /* empty */
          }
        }
        if (!c0) c0 = new Array(conditionNames.length).fill(false);

        function solveLinearSystem(A, b) {
          const n = A.length;
          const M = A.map((r) => r.slice());
          const x = b.slice();

          for (let k = 0; k < n; k++) {
            let maxRow = k;
            let maxVal = Math.abs(M[k][k]);
            for (let i = k + 1; i < n; i++) {
              const v = Math.abs(M[i][k]);
              if (v > maxVal) {
                maxVal = v;
                maxRow = i;
              }
            }
            if (maxVal === 0) throw new Error('Singular matrix');

            if (maxRow !== k) {
              [M[k], M[maxRow]] = [M[maxRow], M[k]];
              [x[k], x[maxRow]] = [x[maxRow], x[k]];
            }

            for (let i = k + 1; i < n; i++) {
              const f = M[i][k] / M[k][k];
              x[i] -= f * x[k];
              for (let j = k; j < n; j++) {
                M[i][j] -= f * M[k][j];
              }
            }
          }

          for (let i = n - 1; i >= 0; i--) {
            let s = x[i];
            for (let j = i + 1; j < n; j++) s -= M[i][j] * x[j];
            x[i] = s / M[i][i];
          }

          return x;
        }

        function newtonSolve(residualFn, z0) {
          const maxIter = 12;
          const tol = 1e-8;
          const n = z0.length;
          let z = z0.slice();

          for (let iter = 0; iter < maxIter; iter++) {
            const r = residualFn(z);

            let maxAbs = 0;
            for (let i = 0; i < n; i++) maxAbs = Math.max(maxAbs, Math.abs(r[i]));
            if (maxAbs < tol) return z;

            const J = Array.from({ length: n }, () => new Array(n).fill(0));
            const epsBase = 1e-6;

            for (let j = 0; j < n; j++) {
              const zj = z[j];
              const eps = epsBase * (1 + Math.abs(zj));
              z[j] = zj + eps;
              const rp = residualFn(z);
              z[j] = zj;
              for (let i = 0; i < n; i++) {
                J[i][j] = (rp[i] - r[i]) / eps;
              }
            }

            const delta = solveLinearSystem(
              J,
              r.map((v) => -v),
            );
            for (let i = 0; i < n; i++) z[i] += delta[i];
          }

          return z;
        }

        function implicitStage(tStage, xBase, yGuess, u, dtStage, pOverride) {
          const z0 = xBase.concat(yGuess);

          function residual(z) {
            const xS = z.slice(0, nx);
            const yS = z.slice(nx);

            const xDot = new Array(nx);
            for (let i = 0; i < nx; i++) {
              xDot[i] = (xS[i] - xBase[i]) / dtStage;
            }

            return model.residual(tStage, xS, xDot, yS, u, pOverride);
          }

          const sol = newtonSolve(residual, z0);
          return {
            x: sol.slice(0, nx),
            y: sol.slice(nx),
          };
        }

        function sdirk2Step(t, x, y, u, dt, pOverride) {
          const gamma = 1 - 1 / Math.sqrt(2);

          const stage1 = implicitStage(t + gamma * dt, x, y, u, gamma * dt, pOverride);

          const z0 = stage1.x.concat(stage1.y);

          function residualStage2(z) {
            const x2 = z.slice(0, nx);
            const y2 = z.slice(nx);

            const xDot = new Array(nx);
            for (let i = 0; i < nx; i++) {
              xDot[i] =
                ((x2[i] - x[i]) / dt - ((1 - gamma) * (stage1.x[i] - x[i])) / (gamma * dt)) / gamma;
            }

            return model.residual(t + dt, x2, xDot, y2, u, pOverride);
          }

          const sol2 = newtonSolve(residualStage2, z0);

          return {
            x: sol2.slice(0, nx),
            y: sol2.slice(nx),
          };
        }

        function simulate(t0, tf, dt, opts) {
          opts = opts || {};
          const pOverride = opts.pOverride || null;
          const f_u = typeof opts.f_u === 'function' ? opts.f_u : (_t) => new Array(nu).fill(0);

          const nSteps = Math.max(1, Math.floor((tf - t0) / dt));
          const tArr = [];
          const xArr = [];
          const yArr = [];
          const uArr = [];
          const cArr = [];

          let t = t0;
          let x = (opts.x0 || x0_model).slice();
          let y = y0_model.slice();
          let c = c0.slice();

          for (let k = 0; k <= nSteps; k++) {
            const u = f_u(t) || new Array(nu).fill(0);

            tArr.push(t);
            xArr.push(x.slice());
            yArr.push(y.slice());
            uArr.push(u.slice());
            cArr.push(c.slice());

            if (k === nSteps) break;

            let step;
            try {
              step = sdirk2Step(t, x, y, u, dt, pOverride);
            } catch (e) {
              console.warn('SDIRK step failed at t =', t, e);
              break;
            }

            let xNext = step.x;
            let yNext = step.y;
            let cNext = c.slice();

            if (haveEvents) {
              const uNext = f_u(t + dt) || new Array(nu).fill(0);
              let cPrev = c.slice();
              let cCurr = cPrev.slice();
              try {
                const ce = model.evalConditions(t + dt, xNext, yNext, uNext, pOverride);
                if (Array.isArray(ce)) cCurr = ce.slice();
              } catch {
                /* empty */
              }

              const applied = model.applyResets
                ? model.applyResets(t + dt, xNext, yNext, uNext, pOverride, cPrev, cCurr)
                : null;

              if (applied?.x) xNext = applied.x.slice();
              if (applied?.y) yNext = applied.y.slice();
              if (applied?.c) cNext = applied.c.slice();
            }

            t += dt;
            x = xNext;
            y = yNext;
            c = cNext;
          }

          return { t: tArr, x: xArr, y: yArr, u: uArr, c: cArr };
        }

        const sim = params?.sim || {};
        const raw = simulate(sim.t0 ?? 0, sim.tf ?? 5, sim.dt ?? 0.1, {
          x0: sim.x0,
          f_u: sim.f_u,
        });

        return {
          meta: {
            t0: sim.t0 ?? 0,
            tf: sim.tf ?? 5,
            dt: sim.dt ?? 0.1,
            nSteps: raw.t.length,
            model: {
              name: model.name || meta.name || 'UnnamedModel',
              stateNames,
              inputNames,
              algebraicNames,
              conditionNames,
            },
            context: context || null,
          },
          data: {
            t: raw.t,
            x: Object.fromEntries(stateNames.map((n, i) => [n, raw.x.map((r) => r[i])])),
            y: Object.fromEntries(algebraicNames.map((n, i) => [n, raw.y.map((r) => r[i])])),
            u: Object.fromEntries(inputNames.map((n, i) => [n, raw.u.map((r) => r[i])])),
            c: Object.fromEntries(conditionNames.map((n, i) => [n, raw.c.map((r) => r[i])])),
          },
        };
      };

      /* ---------------------------------------------------------------------
       * UI
       * -------------------------------------------------------------------*/

      const model = Model();
      const nu = (model?.meta?.inputs || []).length;
      document.getElementById("nuCount").textContent = String(nu);

      const elT0 = document.getElementById("t0");
      const elTf = document.getElementById("tf");
      const elDt = document.getElementById("dt");
      const elInputFn = document.getElementById("inputFn");
      const elRun = document.getElementById("runBtn");
      const elCsv = document.getElementById("csvBtn");
      const elStatus = document.getElementById("status");
      const elSummary = document.getElementById("summary");
      const elSeries = document.getElementById("seriesSelect");

      const elPlot = document.getElementById("plot");
      const elGrid = document.getElementById("grid");
      const elLine = document.getElementById("line");
      const elPlotLabel = document.getElementById("plotLabel");
      const elPlotRange = document.getElementById("plotRange");
      const elBall = document.getElementById("ball");
      const elGround = document.getElementById("groundLine");

      let lastResult = null;

      function setStatus(msg, kind) {
        elStatus.textContent = msg;
        elStatus.classList.remove("good");
        elStatus.classList.remove("bad");
        if (kind === "good") elStatus.classList.add("good");
        if (kind === "bad") elStatus.classList.add("bad");
      }

      function safeNumber(v) {
        return Number.isFinite(v) ? v : NaN;
      }

      function buildSeriesOptions(result) {
        while (elSeries.firstChild) elSeries.removeChild(elSeries.firstChild);

        const keys = [];
        const addGroup = (prefix, obj) => {
          if (!obj) return;
          for (const k of Object.keys(obj)) keys.push(prefix + k);
        };

        addGroup("x.", result?.data?.x);
        addGroup("y.", result?.data?.y);
        addGroup("u.", result?.data?.u);
        addGroup("c.", result?.data?.c);

        keys.sort();

        for (const k of keys) {
          const opt = document.createElement("option");
          opt.value = k;
          opt.textContent = k;
          elSeries.appendChild(opt);
        }

        if (keys.length > 0) {
          elSeries.value = keys[0];
        }
      }

      function getSeries(result, key) {
        const t = result?.data?.t || [];
        const [grp, ...rest] = String(key || "").split(".");
        const name = rest.join(".");
        const group = result?.data?.[grp] || null;
        const y = group?.[name] || [];
        return { t, y };
      }

      function drawGrid() {
        while (elGrid.firstChild) elGrid.removeChild(elGrid.firstChild);
        const w = 1000;
        const h = 420;
        const nx = 10;
        const ny = 6;
        for (let i = 1; i < nx; i++) {
          const x = (i * w) / nx;
          const ln = document.createElementNS("http://www.w3.org/2000/svg", "line");
          ln.setAttribute("x1", String(x));
          ln.setAttribute("x2", String(x));
          ln.setAttribute("y1", "0");
          ln.setAttribute("y2", String(h));
          ln.setAttribute("stroke", "#1a263b");
          ln.setAttribute("stroke-width", "1");
          elGrid.appendChild(ln);
        }
        for (let j = 1; j < ny; j++) {
          const y = (j * h) / ny;
          const ln = document.createElementNS("http://www.w3.org/2000/svg", "line");
          ln.setAttribute("x1", "0");
          ln.setAttribute("x2", String(w));
          ln.setAttribute("y1", String(y));
          ln.setAttribute("y2", String(y));
          ln.setAttribute("stroke", "#1a263b");
          ln.setAttribute("stroke-width", "1");
          elGrid.appendChild(ln);
        }
      }

      function plotSeries(t, y, label) {
        const w = 1000;
        const h = 420;

        if (!Array.isArray(t) || !Array.isArray(y) || t.length === 0 || y.length === 0) {
          elLine.setAttribute("points", "");
          elPlotLabel.textContent = label || "";
          elPlotRange.textContent = "No data";
          return;
        }

        const n = Math.min(t.length, y.length);

        let tMin = Infinity, tMax = -Infinity;
        let yMin = Infinity, yMax = -Infinity;
        for (let i = 0; i < n; i++) {
          const ti = safeNumber(t[i]);
          const yi = safeNumber(y[i]);
          if (!Number.isFinite(ti) || !Number.isFinite(yi)) continue;
          tMin = Math.min(tMin, ti);
          tMax = Math.max(tMax, ti);
          yMin = Math.min(yMin, yi);
          yMax = Math.max(yMax, yi);
        }

        if (!Number.isFinite(tMin) || !Number.isFinite(tMax) || !Number.isFinite(yMin) || !Number.isFinite(yMax)) {
          elLine.setAttribute("points", "");
          elPlotLabel.textContent = label || "";
          elPlotRange.textContent = "No finite values";
          return;
        }

        if (tMax === tMin) tMax = tMin + 1;
        if (yMax === yMin) { yMax = yMin + 1; }

        const pts = [];
        for (let i = 0; i < n; i++) {
          const ti = safeNumber(t[i]);
          const yi = safeNumber(y[i]);
          if (!Number.isFinite(ti) || !Number.isFinite(yi)) continue;
          const x = ((ti - tMin) / (tMax - tMin)) * w;
          const yy = h - ((yi - yMin) / (yMax - yMin)) * h;
          pts.push(x.toFixed(2) + "," + yy.toFixed(2));
        }
        elLine.setAttribute("points", pts.join(" "));
        elPlotLabel.textContent = String(label || "");
        elPlotRange.textContent = `t ${tMin.toFixed(4)} to ${tMax.toFixed(4)}  y ${yMin.toFixed(6)} to ${yMax.toFixed(6)}`;
      }

      function setSummary(result) {
        const m = result?.meta || {};
        const mdl = m?.model || {};
        const items = [
          ["model", mdl.name],
          ["t0", m.t0],
          ["tf", m.tf],
          ["dt", m.dt],
          ["steps", m.nSteps],
          ["nx", (mdl.stateNames || []).length],
          ["ny", (mdl.algebraicNames || []).length],
          ["nu", (mdl.inputNames || []).length],
        ];

        elSummary.innerHTML = "";
        for (const [k, v] of items) {
          const dk = document.createElement("div");
          dk.className = "key mono";
          dk.textContent = String(k);
          const dv = document.createElement("div");
          dv.className = "val mono";
          dv.textContent = String(v);
          elSummary.appendChild(dk);
          elSummary.appendChild(dv);
        }
      }

      let ballAnimHandle = null;

      function stopBallAnimation() {
        if (ballAnimHandle != null) {
          cancelAnimationFrame(ballAnimHandle);
          ballAnimHandle = null;
        }
      }

      function startBallAnimation(result) {
        stopBallAnimation();

        const t = result?.data?.t || [];
        const hArr = result?.data?.x?.h || [];
        if (!elBall || !Array.isArray(t) || !Array.isArray(hArr) || t.length === 0 || hArr.length === 0) {
          return;
        }

        const n = Math.min(t.length, hArr.length);
        let hMin = 0;
        let hMax = 1;
        for (let i = 0; i < n; i++) {
          const v = safeNumber(hArr[i]);
          if (!Number.isFinite(v)) continue;
          hMax = Math.max(hMax, v);
        }
        if (hMax <= hMin) hMax = hMin + 1;

        const w = 1000;
        const h = 420;
        const groundY = 380;
        const topY = 40;
        const spanY = Math.max(1, groundY - topY);

        elGround?.setAttribute("y1", String(groundY));
        elGround?.setAttribute("y2", String(groundY));

        const startTime = performance.now();
        const simStart = t[0];
        const simEnd = t[n - 1];
        const simSpan = Math.max(1e-9, simEnd - simStart);
        const speed = 1.0;

        function sampleHeight(ts) {
          if (ts <= simStart) return hArr[0];
          if (ts >= simEnd) return hArr[n - 1];
          let i = 0;
          while (i < n - 1 && t[i + 1] < ts) i++;
          const t0 = t[i];
          const t1 = t[i + 1];
          const h0 = hArr[i];
          const h1 = hArr[i + 1];
          const a = (ts - t0) / Math.max(1e-9, t1 - t0);
          return h0 + (h1 - h0) * a;
        }

        function frame(now) {
          const simT = simStart + ((now - startTime) / 1000) * speed;
          const hVal = sampleHeight(simT);
          const hNorm = (hVal - hMin) / (hMax - hMin);
          const y = groundY - hNorm * spanY;
          elBall.setAttribute("cx", String(w * 0.08));
          elBall.setAttribute("cy", String(y));

          if (simT < simEnd) {
            ballAnimHandle = requestAnimationFrame(frame);
          } else {
            ballAnimHandle = null;
          }
        }

        ballAnimHandle = requestAnimationFrame(frame);
      }


      function escapeCsv(s) {
        const v = String(s);
        if (v.includes(",") || v.includes("\n") || v.includes("\r") || v.includes('"')) {
          return '"' + v.replaceAll('"', '""') + '"';
        }
        return v;
      }

      function toWideCsv(result) {
        const t = result?.data?.t || [];
        const x = result?.data?.x || {};
        const y = result?.data?.y || {};
        const u = result?.data?.u || {};
        const c = result?.data?.c || {};

        const series = [];
        const add = (prefix, obj) => {
          for (const k of Object.keys(obj || {}).sort()) {
            series.push({ key: prefix + k, values: obj[k] || [] });
          }
        };
        add("x.", x);
        add("y.", y);
        add("u.", u);
        add("c.", c);

        const header = ["t"].concat(series.map(s => s.key));
        const lines = [header.map(escapeCsv).join(",")];

        const n = t.length;
        for (let i = 0; i < n; i++) {
          const row = [t[i]];
          for (const s of series) row.push(s.values[i]);
          lines.push(row.map(escapeCsv).join(","));
        }

        return lines.join("\n");
      }

      function downloadText(filename, content, mime) {
        const blob = new Blob([content], { type: mime || "text/plain;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 500);
      }

      function makeFuFromTextarea() {
        const body = String(elInputFn.value || "");
        try {
          // eslint-disable-next-line no-new-func
          const fn = new Function("t", body);
          return (t) => {
            let out = fn(t);

            // For models with no inputs, allow the function to return nothing.
            if (out == null) {
              if (nu === 0) return [];
              throw new Error("f_u must return an array");
            }

            if (!Array.isArray(out)) {
              // Convenience: if there is exactly one input, allow returning a scalar.
              if (nu === 1 && typeof out === "number" && Number.isFinite(out)) return [out];
              throw new Error("f_u must return an array");
            }

            if (out.length !== nu) {
              if (!(nu === 0 && out.length === 0)) {
                throw new Error(`Expected ${nu} inputs but got ${out.length}`);
              }
            }
            return out;
          };
        } catch (e) {
          throw new Error("Input function error: " + (e?.message || String(e)));
        }
      }

      async function run() {
        elRun.disabled = true;
        elCsv.disabled = true;
        setStatus("Running...", "");

        try {
          const t0 = Number(elT0.value);
          const tf = Number(elTf.value);
          const dt = Number(elDt.value);

          if (!Number.isFinite(t0) || !Number.isFinite(tf) || !Number.isFinite(dt)) {
            throw new Error("t0 tf dt must be finite numbers");
          }
          if (dt <= 0) {
            throw new Error("dt must be > 0");
          }
          if (tf <= t0) {
            throw new Error("tf must be > t0");
          }

          const f_u = makeFuFromTextarea();

          const params = { sim: { t0, tf, dt, f_u } };
          const context = { source: "standalone_html", compiledAt: new Date().toISOString() };

          const result = simulateModel(params, context, model);
          lastResult = result;

          buildSeriesOptions(result);
          setSummary(result);

          const sel = elSeries.value;
          const s = getSeries(result, sel);
          plotSeries(s.t, s.y, sel);
          startBallAnimation(result);

          elCsv.disabled = false;
          setStatus("Simulation complete.", "good");
        } catch (e) {
          console.error(e);
          setStatus(String(e?.message || e), "bad");
        } finally {
          elRun.disabled = false;
        }
      }

      elRun.addEventListener("click", run);
      elSeries.addEventListener("change", () => {
        if (!lastResult) return;
        const sel = elSeries.value;
        const s = getSeries(lastResult, sel);
        plotSeries(s.t, s.y, sel);
      });

      elCsv.addEventListener("click", () => {
        if (!lastResult) return;
        const csv = toWideCsv(lastResult);
        const stamp = new Date().toISOString().replaceAll(":", "-").replaceAll(".", "-");
        downloadText(`simulation_${stamp}.csv`, csv, "text/csv;charset=utf-8");
      });

      // initial render
      drawGrid();
      setStatus("Ready.", "");
    </script>
  </body>
</html>
