{
  "name": "@taskyon/p2p-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "import": "./dist/relay.js",
      "require": "./dist/relay.cjs"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js",
      "require": "./dist/discovery.cjs"
    },
    "./p2pBus": {
      "types": "./dist/p2pBus.d.ts",
      "import": "./dist/p2pBus.js",
      "require": "./dist/p2pBus.cjs"
    },
    "./p2pManager": {
      "types": "./dist/p2pManager.d.ts",
      "import": "./dist/p2pManager.js",
      "require": "./dist/p2pManager.cjs"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "require": "./dist/stream.cjs"
    },
    "./testNetworks": {
      "types": "./dist/testNetworks.d.ts",
      "import": "./dist/testNetworks.js",
      "require": "./dist/testNetworks.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/autonat": "^3.0.12",
    "@libp2p/circuit-relay-v2": "^4.1.5",
    "@libp2p/identify": "^4.0.12",
    "@libp2p/interface": "^3.2.5",
    "@libp2p/interface-internal": "^3.1.8",
    "@libp2p/logger": "^6.0.5",
    "@libp2p/peer-id": "^6.0.4",
    "@libp2p/ping": "^3.0.12",
    "@libp2p/tcp": "^11.0.12",
    "@libp2p/webrtc": "^6.0.13",
    "@libp2p/websockets": "^10.1.5",
    "@libp2p/webtransport": "^6.0.14",
    "@multiformats/multiaddr": "^13.0.1",
    "@multiformats/multiaddr-matcher": "^3.0.1",
    "@taskyon/protocol": "workspace:*",
    "it-length-prefixed-stream": "^2.0.3",
    "it-stream-types": "^2.0.4",
    "libp2p": "^3.1.5",
    "multiformats": "^13.4.0",
    "uint8arraylist": "^3.0.2",
    "weald": "^1.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
