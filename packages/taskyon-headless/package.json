{
  "name": "@taskyon/taskyon-headless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Node-based headless Taskyon diagnostics runner",
  "scripts": {
    "run": "node --import ./src/register.ts --experimental-strip-types ./src/cli.ts",
    "diagnostics": "node --import ./src/register.ts --experimental-strip-types ./src/cli.ts",
    "diagnostics:modelica": "node --import ./src/register.ts --experimental-strip-types ./src/modelicaDiagnosticsCli.ts",
    "discovery-fixture": "node --import ./src/register.ts --experimental-strip-types ./src/cli.ts --online --filter \"Shared Headless Browser Discovery Fixture\" --details",
    "discovery-fixture:run": "node --import ./src/register.ts --experimental-strip-types ./src/discoveryFixture.ts",
    "test-list": "node --import ./src/register.ts --experimental-strip-types ./src/cli.ts --list"
  }
}
