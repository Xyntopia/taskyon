{
  "base": {
    "chatCompletion": {
      "timeouts": {
        "totalMs": 600000,
        "stepMs": 600000
      }
    },
    "cliFlow": {
      "use_baseprompt": true,
      "pinnedTools": ["read", "write", "edit", "grep", "find", "ls", "executeJavaScript", "bash"],
      "toolSearchEnabled": true,
      "recentToolCount": 3,
      "frequentToolCount": 3,
      "recentSearchToolCount": 3,
      "max_error_retries": 3,
      "use_multimodal": true,
      "reasoning_effort": "low",
      "websearch": {
        "enabled": true,
        "max_results": 5
      },
      "prompt_templates": {
        "basePrompt": "You are Taskyon, a concise and accurate terminal assistant. Answer directly when no tool is needed. Follow project instructions and preserve exact names and URLs.",
        "message": "Complete the request in the requested order.",
        "toolResult": "Continue from the tool result, or answer if done.",
        "error": "Tool error: {error}. Retry with corrected arguments if recoverable; otherwise explain the failure.",
        "retryExhausted": "The tool failed {retryCount} times. Stop retrying and explain the failure."
      }
    }
  },
  "profiles": {
    "taskyon": {
      "chatCompletion": {
        "provider": "taskyon",
        "networkTransport": "auto",
        "name": "taskyon",
        "baseURL": "https://share.taskyon.space",
        "model": "z-ai/glm-5.3-flash",
        "streamSupport": true,
        "defaultHeaders": {
          "apiKey": "sb_publishable_WrQ1aIRvl9BrMtpMQ9TocQ_JN7I9kJm",
          "HTTP-Referer": "https://tycli.local",
          "X-Title": "tycli"
        },
        "routes": {
          "chatCompletion": "/chatCompletion/api/v1/",
          "models": "/chatCompletion/api/v1/models"
        }
      }
    },
    "openai": {
      "chatCompletion": {
        "provider": "openai",
        "networkTransport": "auto",
        "name": "openai",
        "baseURL": "https://api.openai.com",
        "model": "gpt-5.1",
        "streamSupport": true,
        "routes": {
          "chatCompletion": "/v1/",
          "models": "/v1/models"
        }
      }
    },
    "chatgpt-codex": {
      "chatCompletion": {
        "provider": "chatgpt-codex",
        "networkTransport": "auto",
        "name": "chatgpt-codex",
        "baseURL": "https://chatgpt.com/backend-api/codex",
        "model": "gpt-5.4",
        "streamSupport": true,
        "auth": {
          "type": "oauth",
          "oauth": {
            "authorizationUrl": "https://auth.openai.com/oauth/authorize",
            "tokenUrl": "https://auth.openai.com/oauth/token",
            "clientId": "app_EMoamEEZ73f0CkXaXp7hrann",
            "scope": "openid profile email offline_access",
            "authorizeQuery": {
              "id_token_add_organizations": "true",
              "codex_cli_simplified_flow": "true"
            }
          }
        },
        "routes": {
          "chatCompletion": "/responses",
          "models": "/models"
        }
      }
    },
    "openrouter.ai": {
      "chatCompletion": {
        "provider": "openrouter.ai",
        "networkTransport": "auto",
        "name": "openrouter.ai",
        "baseURL": "https://openrouter.ai",
        "model": "google/gemini-2.5-flash-lite",
        "streamSupport": true,
        "defaultHeaders": {
          "HTTP-Referer": "https://tycli.local",
          "X-Title": "tycli"
        },
        "routes": {
          "chatCompletion": "/api/v1/",
          "models": "/api/v1/models"
        }
      }
    },
    "local": {
      "chatCompletion": {
        "provider": "local",
        "networkTransport": "auto",
        "name": "local LLM server",
        "baseURL": "http://localhost:8080",
        "model": "qwen3-4b",
        "streamSupport": true,
        "routes": {
          "chatCompletion": "/v1/",
          "models": "/v1/models"
        }
      }
    }
  }
}
