{
  "name": "@taskyon/tycli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Node-based Taskyon CLI for chat and diagnostics",
  "bin": "./bin/tycli.cjs",
  "scripts": {
    "dev": "yarn node --import ./src/register.ts --experimental-strip-types ./src/cli.ts",
    "build": "tsup && chmod +x ./dist/cli.cjs",
    "cli-diagnostics": "node --import ./src/register.ts --experimental-strip-types ./src/diagnostics/runDiagnostics.ts",
    "cli-diagnostics:list": "node --import ./src/register.ts --experimental-strip-types ./src/diagnostics/runDiagnostics.ts --list",
    "cli-diagnostics:modelica": "node --import ./src/register.ts --experimental-strip-types ./src/diagnostics/modelicaDiagnosticsCli.ts",
    "discovery-fixture": "node --import ./src/register.ts --experimental-strip-types ./src/diagnostics/discoveryFixture.ts",
    "diagnostics": "yarn cli-diagnostics",
    "diagnostics:modelica": "yarn cli-diagnostics:modelica",
    "lint": "eslint -c ../../eslint.config.js './src/**/*.{ts,js,mjs,cjs}'",
    "lint:fix": "eslint -c ../../eslint.config.js './src/**/*.{ts,js,mjs,cjs}' --fix",
    "typecheck": "bash -lc 'set -o pipefail; out=$(tsc -p ./tsconfig.lint.json --noEmit 2>&1 || true); cli=$(printf \"%s\\n\" \"$out\" | grep -E \"^src/cli(\\.ts|/)\" || true); if [ -n \"$cli\" ]; then printf \"%s\\n\" \"$cli\"; exit 2; fi'",
    "test:e2e": "yarn node --import ./src/register.ts --experimental-strip-types ./src/tests/runCliDiagnostics.ts",
    "test:e2e:all": "TYCLI_E2E_INCLUDE_EXPERIMENTAL=1 yarn node --import ./src/register.ts --experimental-strip-types ./src/tests/runCliDiagnostics.ts",
    "test": "yarn test:e2e",
    "run": "yarn node --import ./src/register.ts --experimental-strip-types ./src/cli.ts",
    "start": "node ./dist/cli.cjs"
  },
  "dependencies": {
    "@taskyon/tyclient": "workspace:*",
    "terminal-kit": "^3.1.2",
    "zod": "^4.0.0-beta.20250505T195954"
  }
}
