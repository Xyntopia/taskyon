{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": ["node"],
    "paths": {
      "@taskyon/taskyon/*": ["../taskyon/src/*"],
      "@taskyon/common/*": ["../common/*"],
      "@taskyon/comp-dag/*": ["../comp-dag/*"],
      "@taskyon/modelica/*": ["../modelica/*"],
      "@taskyon/spaceships/*": ["../spaceships/*"],
      "@taskyon/surrogate/*": ["../surrogate/*"],
      "@taskyon/ui/*": ["../ui/*"],
      "@taskyon/taskyon/api": ["../taskyon/src/api/index.ts"],
      "@taskyon/tyclient": ["../tyclient/src/index.ts"]
    }
  },
  "include": ["src/cli.ts", "src/cli/**/*.ts"]
}
