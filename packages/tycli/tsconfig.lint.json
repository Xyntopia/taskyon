{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": [
      "node"
    ],
    "paths": {
      "@taskyon/taskyon/*": [
        "../taskyon/src/*"
      ],
      "@taskyon/shared/*": [
        "../shared/*"
      ],
      "@taskyon/taskyon/api": [
        "../taskyon/src/api/index.ts"
      ]
    }
  },
  "include": [
    "src/cli.ts",
    "src/cli/**/*.ts"
  ]
}
