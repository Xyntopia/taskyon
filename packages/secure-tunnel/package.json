{
  "name": "@taskyon/secure-tunnel",
  "version": "0.0.1",
  "description": "Browser-side HTTPS-over-WebSocket tunnel client with in-browser TLS termination",
  "type": "module",
  "main": "./dist/secure-tunnel.umd.cjs",
  "module": "./dist/secure-tunnel.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@taskyon/common": "workspace:*",
    "@taskyon/https-tunnel-wasm": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  },
  "keywords": [
    "tls",
    "https",
    "websocket",
    "tunnel",
    "browser",
    "secure-fetch"
  ],
  "license": "MIT"
}
