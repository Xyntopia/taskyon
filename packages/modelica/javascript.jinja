{# rumoca-ir: solve #}
{%- set model_name = model_name if model_name is defined and model_name else "GeneratedModel" -%}
{%- set varn = namespace(
  x_names=[], y_names=[], z_names=[], m_names=[], w_names=[], u_names=[], p_names=[], cp_names=[],
  x_base=[], y_base=[], z_base=[], m_base=[], w_base=[], u_base=[], p_base=[], cp_base=[],
  x_solve_slots=[], y_solve_slots=[]
) -%}
{%- for v in dae.variables -%}
  {%- set sn = v.scalar_names if v.scalar_names is defined else [] -%}
  {%- if v.role == "state" -%}
    {%- set varn.x_base = varn.x_base + [varn.x_names|length] -%}
    {%- set storage = solve.solve_layout.variable_storage_runs[v.id].base.Y.index -%}
    {%- for n in sn -%}
      {%- set varn.x_names = varn.x_names + [n] -%}
      {%- set varn.x_solve_slots = varn.x_solve_slots + [storage + loop.index0] -%}
    {%- endfor -%}
  {%- else -%}{%- set varn.x_base = varn.x_base + [-1] -%}{%- endif -%}
  {%- if v.role == "algebraic" -%}
    {%- set varn.y_base = varn.y_base + [varn.y_names|length] -%}
    {%- set storage = solve.solve_layout.variable_storage_runs[v.id].base.Y.index -%}
    {%- for n in sn -%}
      {%- set varn.y_names = varn.y_names + [n] -%}
      {%- set varn.y_solve_slots = varn.y_solve_slots + [storage + loop.index0] -%}
    {%- endfor -%}
  {%- else -%}{%- set varn.y_base = varn.y_base + [-1] -%}{%- endif -%}
  {%- if v.role == "discrete_real" -%}
    {%- set varn.z_base = varn.z_base + [varn.z_names|length] -%}
    {%- for n in sn -%}{%- set varn.z_names = varn.z_names + [n] -%}{%- endfor -%}
  {%- else -%}{%- set varn.z_base = varn.z_base + [-1] -%}{%- endif -%}
  {%- if v.role == "discrete_value" -%}
    {%- set varn.m_base = varn.m_base + [varn.m_names|length] -%}
    {%- for n in sn -%}{%- set varn.m_names = varn.m_names + [n] -%}{%- endfor -%}
  {%- else -%}{%- set varn.m_base = varn.m_base + [-1] -%}{%- endif -%}
  {%- if v.role == "output" -%}
    {%- set varn.w_base = varn.w_base + [varn.w_names|length] -%}
    {%- for n in sn -%}{%- set varn.w_names = varn.w_names + [n] -%}{%- endfor -%}
  {%- else -%}{%- set varn.w_base = varn.w_base + [-1] -%}{%- endif -%}
  {%- if v.role == "input" -%}
    {%- set varn.u_base = varn.u_base + [varn.u_names|length] -%}
    {%- for n in sn -%}{%- set varn.u_names = varn.u_names + [n] -%}{%- endfor -%}
  {%- else -%}{%- set varn.u_base = varn.u_base + [-1] -%}{%- endif -%}
  {%- if v.role == "parameter" -%}
    {%- set varn.p_base = varn.p_base + [varn.p_names|length] -%}
    {%- for n in sn -%}{%- set varn.p_names = varn.p_names + [n] -%}{%- endfor -%}
  {%- else -%}{%- set varn.p_base = varn.p_base + [-1] -%}{%- endif -%}
  {%- if v.role == "constant" -%}
    {%- set varn.cp_base = varn.cp_base + [varn.cp_names|length] -%}
    {%- for n in sn -%}{%- set varn.cp_names = varn.cp_names + [n] -%}{%- endfor -%}
  {%- else -%}{%- set varn.cp_base = varn.cp_base + [-1] -%}{%- endif -%}
{%- endfor -%}
{%- set ny_var = varn.y_names|length + varn.z_names|length + varn.m_names|length + varn.w_names|length -%}
{%- set evt = namespace(n_eqs=0, n_init=0, n_conditions=dae.systems.conditions.conditions|length, n_discrete_when=0, has_any_when=false) -%}
{%- for owner in dae.systems.continuous.owners -%}
  {%- set evt.n_eqs = evt.n_eqs + (1 if owner.kind == "residual" else owner.scalar_rows) -%}
{%- endfor -%}
{%- for owner in dae.systems.initialization.owners -%}
  {%- set evt.n_init = evt.n_init + (1 if owner.kind == "residual" else owner.scalar_rows) -%}
{%- endfor -%}
{%- for res in dae.systems.discrete_real.residuals -%}
  {%- if res.activation.kind == "when" -%}
    {%- set evt.has_any_when = true -%}
    {%- set evt.n_discrete_when = evt.n_discrete_when + 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- for owner in dae.systems.discrete_values.owners -%}
  {%- for branch in owner.branches -%}
    {%- if branch.activation.kind == "when" -%}
      {%- set evt.has_any_when = true -%}
      {%- set evt.n_discrete_when = evt.n_discrete_when + 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set n_events = evt.n_conditions + evt.n_discrete_when + dae.systems.events.actions|length -%}

{# Checked Solve programs are emitted as ordinary JavaScript expressions. #}
{%- macro solve_unary(op) -%}
{%- if op.operator == 'Neg' -%}(-r{{ op.arg }})
{%- elif op.operator == 'Not' -%}(r{{ op.arg }} === 0 ? 1 : 0)
{%- elif op.operator == 'Sign' -%}Math.sign(r{{ op.arg }})
{%- else -%}Math.{{ op.operator|lower }}(r{{ op.arg }})
{%- endif -%}
{%- endmacro -%}
{%- macro solve_binary(op) -%}
{%- set operators = {'Add': '+', 'Sub': '-', 'Mul': '*', 'Div': '/', 'Pow': '**'} -%}
{%- if op.operator in operators -%}(r{{ op.lhs }} {{ operators[op.operator] }} r{{ op.rhs }})
{%- elif op.operator == 'And' -%}((r{{ op.lhs }} !== 0 && r{{ op.rhs }} !== 0) ? 1 : 0)
{%- elif op.operator == 'Or' -%}((r{{ op.lhs }} !== 0 || r{{ op.rhs }} !== 0) ? 1 : 0)
{%- else -%}Math.{{ op.operator|lower }}(r{{ op.lhs }}, r{{ op.rhs }})
{%- endif -%}
{%- endmacro -%}
{%- macro solve_op(op, output) %}
{%- if op.kind == 'Const' %}
      const r{{ op.dst }} = {{ op.value if op.value_class == 'finite' else ('Infinity' if op.value_class == 'positive_infinity' else ('-Infinity' if op.value_class == 'negative_infinity' else 'NaN')) }};
{%- elif op.kind == 'LoadTime' %}
      const r{{ op.dst }} = t;
{%- elif op.kind == 'LoadY' %}
      const r{{ op.dst }} = sy[{{ op.index }}];
{%- elif op.kind == 'LoadP' %}
      const r{{ op.dst }} = sp[{{ op.index }}];
{%- elif op.kind == 'Move' %}
      const r{{ op.dst }} = r{{ op.src }};
{%- elif op.kind == 'Unary' %}
      const r{{ op.dst }} = {{ solve_unary(op) }};
{%- elif op.kind == 'Binary' %}
      const r{{ op.dst }} = {{ solve_binary(op) }};
{%- elif op.kind == 'Compare' %}
{%- set operators = {'Lt': '<', 'Le': '<=', 'Gt': '>', 'Ge': '>=', 'Eq': '===', 'Ne': '!=='} %}
      const r{{ op.dst }} = (r{{ op.lhs }} {{ operators[op.operator] }} r{{ op.rhs }}) ? 1 : 0;
{%- elif op.kind == 'Select' %}
      const r{{ op.dst }} = r{{ op.cond }} !== 0 ? r{{ op.if_true }} : r{{ op.if_false }};
{%- elif op.kind == 'StoreOutput' %}
      {{ output }}[{{ op.output_index }}] = r{{ op.src }};
{%- elif op.kind == 'StoreOutputRange' %}
{%- for index in op.output_indices %}
      {{ output }}[{{ index }}] = r{{ op.start + loop.index0 * op.stride }};
{%- endfor %}
{%- else %} {{ fail('unsupported-feature:javascript.solve.' ~ op.kind) }}
{%- endif %}
{%- endmacro %}
{%- set reduction = namespace(enabled=false) -%}
{%- if solve is defined and solve.continuous.exact_algebraic_assignments is not none
    and varn.x_names|length > 0 and n_events == 0
    and varn.u_names|length == 0 and varn.z_names|length == 0
    and varn.m_names|length == 0 and varn.w_names|length == 0
    and solve.solve_layout.state_scalar_count == varn.x_names|length
    and solve.solve_layout.algebraic_scalar_count == varn.y_names|length -%}
{%- set reduction.enabled = true -%}
{%- for plan in [solve.continuous.exact_algebraic_assignments.plan, solve.continuous.derivative_rhs.scalar_plan] -%}
{%- for program in plan.programs -%}
{%- for op in program.ops -%}
{%- if op.kind not in ['Const','LoadTime','LoadY','LoadP','Move','Unary','Binary','Compare','Select','StoreOutput','StoreOutputRange'] -%}
{%- set reduction.enabled = false -%}
{%- elif op.kind == 'Unary' and op.operator not in ['Neg','Not','Abs','Sign','Sqrt','Floor','Ceil','Trunc','Sin','Cos','Tan','Asin','Acos','Atan','Sinh','Cosh','Tanh','Exp','Log','Log10'] -%}
{%- set reduction.enabled = false -%}
{%- elif op.kind == 'Binary' and op.operator not in ['Add','Sub','Mul','Div','Pow','And','Or','Atan2','Min','Max'] -%}
{%- set reduction.enabled = false -%}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- endfor -%}
{%- endif -%}
{%- macro q(text) -%}{{ text|string|replace('\\', '\\\\')|replace('"', '\\"') }}{%- endmacro -%}

{%- macro var_unit_prop(v) -%}
{%- set u = v.attributes.unit if v.attributes is defined and v.attributes.unit is defined else none -%}
{%- if u is not none and (u|string)|trim != '' and (u|string)|trim|lower != 'none' and (u|string)|trim|lower != 'null' %}, unit: "{{ q((u|string)|trim) }}"{%- endif -%}
{%- endmacro -%}

{%- macro coord_name(vid) -%}{{ dae.variables[vid].name }}{%- endmacro -%}

{%- macro coord_ref(coord, mode="code", symbol_mode="indexed") -%}
{%- set kind = coord.kind -%}
{%- if kind == "time" -%}t
{%- elif kind == "parameter" -%}
  {%- set v = dae.variables[coord.id] -%}
  {%- if v.role == "constant" -%}constants["{{ q(v.name) }}"]
  {%- else -%}P[{{ varn.p_base[coord.id] }}]
  {%- endif -%}
{%- elif kind == "constant" -%}
  {%- set v = dae.variables[coord.id] -%}
  constants["{{ q(v.name) }}"]
{%- elif kind == "input" -%}U[{{ varn.u_base[coord.id] }}]
{%- elif kind == "state" -%}X[{{ varn.x_base[coord.id] }}]
{%- elif kind == "derivative" -%}XDot[{{ varn.x_base[coord.id] }}]
{%- elif kind == "algebraic" -%}
  {%- set v = dae.variables[coord.id] -%}
  {%- if v.role == "output" -%}Y[{{ varn.y_names|length + varn.z_names|length + varn.m_names|length + varn.w_base[coord.id] }}]
  {%- else -%}Y[{{ varn.y_base[coord.id] }}]
  {%- endif -%}
{%- elif kind == "discrete_real" -%}Y[{{ varn.y_names|length + varn.z_base[coord.id] }}]
{%- elif kind == "discrete_value" -%}Y[{{ varn.y_names|length + varn.z_names|length + varn.m_base[coord.id] }}]
{%- elif kind == "pre_state" -%}__rumocaPre("{{ q(dae.variables[coord.id].name) }}", X[{{ varn.x_base[coord.id] }}])
{%- elif kind == "pre_algebraic" -%}
  {%- set v = dae.variables[coord.id] -%}
  {%- if v.role == "output" -%}__rumocaPre("{{ q(v.name) }}", Y[{{ varn.y_names|length + varn.z_names|length + varn.m_names|length + varn.w_base[coord.id] }}])
  {%- else -%}__rumocaPre("{{ q(v.name) }}", Y[{{ varn.y_base[coord.id] }}])
  {%- endif -%}
{%- elif kind == "pre_discrete_real" -%}__rumocaPre("{{ q(dae.variables[coord.id].name) }}", Y[{{ varn.y_names|length + varn.z_base[coord.id] }}])
{%- elif kind == "pre_discrete_value" -%}__rumocaPre("{{ q(dae.variables[coord.id].name) }}", Y[{{ varn.y_names|length + varn.z_names|length + varn.m_base[coord.id] }}])
{%- elif kind == "condition" -%}(Array.isArray(cCurr) ? Boolean(cCurr[{{ coord.id }}]) : false)
{%- elif kind == "binder" -%}__rb_{{ coord.domain }}_{{ coord.ordinal }}
{%- elif kind == "function_parameter" -%}__p{{ coord.ordinal }}
{%- else -%}__rumocaUnsupported("coordinate:{{ kind }}", __rumocaFunctionName)
{%- endif -%}
{%- endmacro -%}

{%- macro coord_indexed(coord, offset, mode="code", symbol_mode="indexed") -%}
{%- set kind = coord.kind -%}
{%- if kind == "state" -%}X[{{ varn.x_base[coord.id] }} + ({{ offset }})]
{%- elif kind == "derivative" -%}XDot[{{ varn.x_base[coord.id] }} + ({{ offset }})]
{%- elif kind == "algebraic" -%}
  {%- set v = dae.variables[coord.id] -%}
  {%- if v.role == "output" -%}Y[{{ varn.y_names|length + varn.z_names|length + varn.m_names|length + varn.w_base[coord.id] }} + ({{ offset }})]
  {%- else -%}Y[{{ varn.y_base[coord.id] }} + ({{ offset }})]
  {%- endif -%}
{%- elif kind == "discrete_real" -%}Y[{{ varn.y_names|length + varn.z_base[coord.id] }} + ({{ offset }})]
{%- elif kind == "discrete_value" -%}Y[{{ varn.y_names|length + varn.z_names|length + varn.m_base[coord.id] }} + ({{ offset }})]
{%- elif kind == "parameter" -%}
  {%- set v = dae.variables[coord.id] -%}
  {%- if v.role == "constant" -%}constants["{{ q(v.name) }}"]
  {%- else -%}P[{{ varn.p_base[coord.id] }} + ({{ offset }})]
  {%- endif -%}
{%- elif kind == "constant" -%}constants["{{ q(dae.variables[coord.id].name) }}"]
{%- elif kind == "input" -%}U[{{ varn.u_base[coord.id] }} + ({{ offset }})]
{%- elif kind == "pre_state" -%}__rumocaPre("{{ q(dae.variables[coord.id].name) }}", X[{{ varn.x_base[coord.id] }} + ({{ offset }})])
{%- elif kind == "pre_algebraic" -%}
  {%- set v = dae.variables[coord.id] -%}
  {%- if v.role == "output" -%}__rumocaPre("{{ q(v.name) }}", Y[{{ varn.y_names|length + varn.z_names|length + varn.m_names|length + varn.w_base[coord.id] }} + ({{ offset }})])
  {%- else -%}__rumocaPre("{{ q(v.name) }}", Y[{{ varn.y_base[coord.id] }} + ({{ offset }})])
  {%- endif -%}
{%- elif kind == "pre_discrete_real" -%}__rumocaPre("{{ q(dae.variables[coord.id].name) }}", Y[{{ varn.y_names|length + varn.z_base[coord.id] }} + ({{ offset }})])
{%- elif kind == "pre_discrete_value" -%}__rumocaPre("{{ q(dae.variables[coord.id].name) }}", Y[{{ varn.y_names|length + varn.z_names|length + varn.m_base[coord.id] }} + ({{ offset }})])
{%- elif kind == "function_parameter" -%}__p{{ coord.ordinal }}[{{ offset }}]
{%- else -%}{{ coord_ref(coord, mode, symbol_mode) }}
{%- endif -%}
{%- endmacro -%}

{%- macro subscript_value(sid, mode, symbol_mode) -%}
{%- set s = dae.expressions[sid].operation -%}
{%- if s.kind == "literal" and s.value.integer is defined -%}{{ s.value.integer }}
{%- elif s.kind == "literal" and s.value.real is defined -%}{{ s.value.real }}
{%- else -%}{{ render_expr(sid, mode, symbol_mode) }}{%- endif -%}
{%- endmacro -%}

{%- macro flat_subscript_offset(subscripts, dims, mode, symbol_mode) -%}
{%- if subscripts|length == 1 and dims|length <= 1 -%}
{%- set s0 = subscripts[0] -%}
{%- if s0.kind == "index" -%}({{ subscript_value(s0.expression, mode, symbol_mode) }}) - 1{%- else -%}__rumocaUnsupported("subscript:{{ s0.kind }}", __rumocaFunctionName){%- endif -%}
{%- elif subscripts|length == dims|length -%}
{%- set parts = namespace(text="") -%}
{%- for s in subscripts -%}
  {%- if s.kind == "index" -%}
    {%- set stride = namespace(value=1) -%}
    {%- for d in dims[loop.index0 + 1:] -%}{%- set stride.value = stride.value * d -%}{%- endfor -%}
    {%- if loop.index0 > 0 -%}{%- set parts.text = parts.text ~ " + " -%}{%- endif -%}
    {%- set parts.text = parts.text ~ "((" ~ subscript_value(s.expression, mode, symbol_mode) ~ ") - 1) * " ~ stride.value -%}
  {%- else -%}
    {%- set parts.text = parts.text ~ "__rumocaUnsupported(\"subscript:" ~ s.kind ~ "\", __rumocaFunctionName)" -%}
  {%- endif -%}
{%- endfor -%}
{{ parts.text }}
{%- else -%}
__rumocaUnsupported("subscript-count", __rumocaFunctionName)
{%- endif -%}
{%- endmacro -%}

{%- macro render_expr(eid, mode="code", symbol_mode="indexed", emit_comment=false, comment_label="") -%}
{%- if emit_comment -%}
/* {{ comment_label }}{{ render_expr(eid, mode, "named")|replace('\n', ' ')|replace('\r', ' ') }} */ {{ render_expr(eid, mode, symbol_mode) }}
{%- else -%}
{%- set e = dae.expressions[eid] -%}
{%- set op = e.operation -%}
{%- set kind = op.kind -%}
{%- if kind == "literal" -%}
  {%- set lit = op.value -%}
  {%- if lit.integer is defined -%}{{ lit.integer }}
  {%- elif lit.real is defined -%}{{ lit.real }}
  {%- elif lit.boolean is defined -%}{{ "true" if lit.boolean else "false" }}
  {%- elif lit.enumeration is defined -%}{{ lit.enumeration }}
  {%- elif lit.string is defined -%}"{{ q(lit.string) }}"
  {%- else -%}0{%- endif -%}
{%- elif kind == "coordinate" -%}
  {{ coord_ref(op.coordinate, mode, symbol_mode) }}
{%- elif kind in ["function_value", "function_conditional_output"] -%}
  __v[{{ op.value }}]
{%- elif kind == "function_fold_parameter" or kind == "function_fold_output" -%}
  __c{{ op.fold }}_{{ op.carried }}
{%- elif kind == "unary" -%}
  {%- if op.operator == "negate" -%}(-({{ render_expr(op.operand, mode, symbol_mode) }}))
  {%- elif op.operator == "not" -%}(!({{ render_expr(op.operand, mode, symbol_mode) }}))
  {%- else -%}(+{{ render_expr(op.operand, mode, symbol_mode) }}){%- endif -%}
{%- elif kind == "binary" -%}
  {%- set o = op.operator -%}
  {%- if o == "add" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} + {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "subtract" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} - {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "multiply" or o == "elementwise_multiply" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} * {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "divide" or o == "elementwise_divide" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} / {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "power" or o == "elementwise_power" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} ** {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "elementwise_add" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} + {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "elementwise_subtract" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} - {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "equal" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} === {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "not_equal" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} !== {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "less" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} < {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "less_equal" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} <= {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "greater" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} > {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "greater_equal" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} >= {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "and" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} && {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- elif o == "or" -%}({{ render_expr(op.lhs, mode, symbol_mode) }} || {{ render_expr(op.rhs, mode, symbol_mode) }})
  {%- else -%}__rumocaUnsupported("binary:{{ o }}", __rumocaFunctionName){%- endif -%}
{%- elif kind == "conditional" -%}
  {{ render_conditional(op.operands, 0, mode, symbol_mode) }}
{%- elif kind == "array" -%}
  [{%- for el in op.elements -%}{{ render_expr(el, mode, symbol_mode) }}{{ ", " if not loop.last }}{%- endfor -%}]
{%- elif kind == "record" -%}
  [{%- for el in op.fields -%}{{ render_expr(el, mode, symbol_mode) }}{{ ", " if not loop.last }}{%- endfor -%}]
{%- elif kind == "field" -%}
  {%- set baseT = dae.expressions[op.base].value_type_id -%}
  {%- set fields = dae.value_types[baseT].value_type.record_fields -%}
  {%- set fname = fields[op.field].name if fields|length > op.field else op.field -%}
  ({{ render_expr(op.base, mode, symbol_mode) }})["{{ q(fname) }}"]
{%- elif kind == "index" -%}
  {%- set baseExpr = dae.expressions[op.base] -%}
  {%- set dims = baseExpr.value_type.dimensions if baseExpr.value_type.dimensions is defined else [] -%}
  {%- set offset = flat_subscript_offset(op.subscripts, dims, mode, symbol_mode) -%}
  {%- if baseExpr.operation.kind == "coordinate" -%}
    {{ coord_indexed(baseExpr.operation.coordinate, offset, mode, symbol_mode) }}
  {%- else -%}
    {{ render_expr(op.base, mode, symbol_mode) }}[{{ offset }}]
  {%- endif -%}
{%- elif kind == "range" -%}
  {%- set step = op.explicit_step if op.explicit_step is not none else none -%}
  __rumocaRange({{ subscript_value(op.start.expression, mode, symbol_mode) }}, {% if step is not none %}{{ subscript_value(step.expression, mode, symbol_mode) }}{% else %}1{% endif %}, {{ subscript_value(op.stop.expression, mode, symbol_mode) }})
{%- elif kind == "comprehension" -%}
  {{ render_comprehension(op.domain, op.body, mode, symbol_mode) }}
{%- elif kind == "builtin" -%}
  {{ render_builtin(op, mode, symbol_mode) }}
{%- elif kind == "call" -%}
  {{ render_call(op, mode, symbol_mode) }}
{%- elif kind == "string_conversion" -%}
