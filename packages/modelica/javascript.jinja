      "{{ q(varn.z_names[varn.z_base[v.id] + i]) }}",
    {%- endfor -%}
    {%- endif -%}
    {%- endfor -%}
    {%- for v in dae.variables -%}
    {%- if v.role == "discrete_value" -%}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 -%}
    {%- for i in range(count) -%}
      "{{ q(varn.m_names[varn.m_base[v.id] + i]) }}",
    {%- endfor -%}
    {%- endif -%}
    {%- endfor -%}
    {%- for v in dae.variables -%}
    {%- if v.role == "output" -%}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 -%}
    {%- for i in range(count) -%}
      "{{ q(varn.w_names[varn.w_base[v.id] + i]) }}",
    {%- endfor -%}
    {%- endif -%}
    {%- endfor -%}
    ],

    inputs: [
    {%- for v in dae.variables %}
    {%- if v.role == "input" %}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
    {%- for i in range(count) %}
      { name: "{{ q(varn.u_names[varn.u_base[v.id] + i]) }}"{{ var_unit_prop(v) }}},
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
    ],

    conditions: [
    {%- for cond in dae.systems.conditions.conditions %}
      { name: "c[{{ loop.index }}]", start: false },
    {%- endfor %}
    ],

    heldAlgebraics: [
    {%- for owner in dae.systems.discrete_values.owners -%}{%- for target in owner.targets -%}
    {%- for offset in ([target.scalar_selection] if target.scalar_selection is not none else range(dae.variables[target.variable].scalar_count)) -%}
    {{ held_slot(target.variable) }} + {{ offset }},
    {%- endfor -%}{%- endfor -%}{%- endfor -%}
    {%- for res in dae.systems.discrete_real.residuals -%}{%- set re = dae.expressions[res.residual].operation -%}{%- if re.kind == "binary" and re.operator == "subtract" -%}{%- set lhs = dae.expressions[re.lhs].operation -%}{%- if lhs.kind == "coordinate" -%}{{ held_slot(lhs.coordinate.id) }},
    {%- endif -%}{%- endif -%}{%- endfor -%}
    ],

    booleanAlgebraics: [
    {%- for v in dae.variables -%}
    {%- if v.value_type.scalar == "boolean" and (v.role == "algebraic" or v.role == "discrete_real" or v.role == "discrete_value" or v.role == "output") -%}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 -%}
    {%- for i in range(count) -%}{{ held_slot(v.id) }} + {{ i }},
    {%- endfor -%}
    {%- endif -%}
    {%- endfor -%}
    ],

    summary: {
      nx: {{ varn.x_names|length }},
      ny: {{ ny_var }},
      nc: {{ dae.systems.conditions.conditions|length }},
      neqs: {{ evt.n_eqs }}
    }
  };

  const stateIndex = {
  {%- for v in dae.variables %}
  {%- if v.role == "state" %}
  {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
  {%- for i in range(count) %}
    "{{ q(varn.x_names[varn.x_base[v.id] + i]) }}": {{ varn.x_base[v.id] + i }},
  {%- endfor %}
  {%- endif %}
  {%- endfor %}
  };

  const algebraicIndex = {
  {%- for v in dae.variables %}
  {%- if v.role == "algebraic" %}
  {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
  {%- for i in range(count) %}
    "{{ q(varn.y_names[varn.y_base[v.id] + i]) }}": {{ varn.y_base[v.id] + i }},
  {%- endfor %}
  {%- elif v.role == "discrete_real" %}
  {%- set slot = varn.y_names|length + varn.z_base[v.id] %}
  {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
  {%- for i in range(count) %}
    "{{ q(varn.z_names[varn.z_base[v.id] + i]) }}": {{ slot + i }},
  {%- endfor %}
  {%- elif v.role == "discrete_value" %}
  {%- set slot = varn.y_names|length + varn.z_names|length + varn.m_base[v.id] %}
  {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
  {%- for i in range(count) %}
    "{{ q(varn.m_names[varn.m_base[v.id] + i]) }}": {{ slot + i }},
  {%- endfor %}
  {%- elif v.role == "output" %}
  {%- set slot = varn.y_names|length + varn.z_names|length + varn.m_names|length + varn.w_base[v.id] %}
  {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
  {%- for i in range(count) %}
    "{{ q(varn.w_names[varn.w_base[v.id] + i]) }}": {{ slot + i }},
  {%- endfor %}
  {%- endif %}
  {%- endfor %}
  };

  function residual(t, X, XDot, Y, U, PIn, cPrev = [], cCurr = []) {
    const P = Array.isArray(PIn) ? PIn : (PIn && Array.isArray(PIn.P) ? PIn.P : P_DEFAULT);
    const __rumocaRows = [];
    {%- for owner in dae.systems.continuous.owners %}
    {%- if owner.kind == "residual" %}
    __rumocaRows.push({{ render_expr(owner.residual, "code", "indexed") }});
    {%- elif owner.scalar_view == "BinderSubstitution" %}
    for (let __rumocaRp = 0; __rumocaRp < {{ owner.scalar_rows }}; __rumocaRp++) {
      {{ binder_assignments(owner.domain, "__rumocaRp") }}
      {%- for body in owner.bodies %}
      __rumocaRows.push({{ render_expr(body, "code", "indexed") }});
      {%- endfor %}
    }
    {%- else %}
    __rumocaRows.push(__rumocaUnsupported("structured-view:{{ owner.scalar_view }}"));
    {%- endif %}
    {%- endfor %}
    return __rumocaRows;
  }

  function evalConditions(t, X, Y, U, PIn, cPrev = [], cCurr = []) {
    __rumocaCurrentTime = t;
    const P = Array.isArray(PIn) ? PIn : (PIn && Array.isArray(PIn.P) ? PIn.P : P_DEFAULT);
    return [
    {%- for cond in dae.systems.conditions.conditions %}
      {{ cond_expression(cond.id, "code", "indexed") }},
    {%- endfor %}
    ];
  }

  function evalEventIndicators(t, X, Y, U, PIn, cPrev = [], cCurr = []) {
    __rumocaCurrentTime = t;
    const P = Array.isArray(PIn) ? PIn : (PIn && Array.isArray(PIn.P) ? PIn.P : P_DEFAULT);
    return [
    {%- for cond in dae.systems.conditions.conditions %}
      {{ cond_indicator(cond.id, "code", "indexed") }},
    {%- endfor %}
    ];
  }

  function evalAlgebraics(t, X, Y, U, PIn, cPrev = [], cCurr = []) {
    __rumocaCurrentTime = t;
    const boolSet = new Set(
      Array.isArray(meta.booleanAlgebraics)
        ? meta.booleanAlgebraics.filter((index) => Number.isInteger(index) && index >= 0)
        : [],
    );
    const out = new Array(meta.algebraics.length).fill(0);
    for (let __rumocaI = 0; __rumocaI < out.length; __rumocaI++) {
      out[__rumocaI] = boolSet.has(__rumocaI)
        ? Number(Y[__rumocaI]) >= 0.5
          ? 1
          : 0
        : __rumocaSignalOr(Y[__rumocaI], 0);
    }
    return out;
  }

  function applyResets(t, xVec, yVec, uVec, PIn, cPrev, cCurr) {
    __rumocaCurrentTime = t;
    __rumocaRuntimeOverrides = Object.create(null);
    const P = Array.isArray(PIn) ? PIn : (PIn && Array.isArray(PIn.P) ? PIn.P : P_DEFAULT);
    const X = xVec;
    const Y = yVec;
    const U = uVec;
    let xNew = xVec.slice();
    let yNew = yVec.slice();
    let cNew = Array.isArray(cCurr) ? cCurr.slice() : [];

    {%- for owner in dae.systems.discrete_values.owners %}
    {%- for branch in owner.branches %}
    if ({{ reset_condition(branch.activation) }}) {
      {%- for value in branch.values %}
      {
        const __rumocaVal = {{ render_expr(value.expression, "code", "indexed") }};
        {%- set target = owner.targets[loop.index0] if owner.targets|length > loop.index0 else owner.targets[0] -%}
        {%- set targetRef = target.variable -%}
        {%- set tv = dae.variables[targetRef] %}
        const __rumocaValues = Array.isArray(__rumocaVal) ? __rumocaVal.flat(Infinity) : [__rumocaVal];
        {%- set offsets = [target.scalar_selection] if target.scalar_selection is not none else range(tv.scalar_count) %}
        if (__rumocaValues.length !== {{ offsets|length }}) __rumocaUnsupported("discrete-target-shape");
        {%- for offset in offsets %}
        {%- if tv.role == "state" %}xNew[{{ varn.x_base[targetRef] + offset }}] = __rumocaValues[{{ loop.index0 }}];
        {%- else %}yNew[{{ held_slot(targetRef) }} + {{ offset }}] = __rumocaValues[{{ loop.index0 }}];
        {%- endif %}
        __rumocaAssignSymbol("{{ q(tv.scalar_names[offset]) }}", __rumocaValues[{{ loop.index0 }}]);
        {%- endfor %}
      }
      {%- endfor %}
    }
    {%- endfor %}
    {%- endfor %}

    {%- for res in dae.systems.discrete_real.residuals %}
    if ({{ reset_condition(res.activation) }}) {
      {%- set re = dae.expressions[res.residual].operation %}
      {%- if re.kind == "binary" and re.operator == "subtract" %}
      {%- set lhsExpr = dae.expressions[re.lhs] %}
      {%- if lhsExpr.operation.kind == "coordinate" and lhsExpr.operation.coordinate.kind == "discrete_real" %}
      {
        const __rumocaVal = {{ render_expr(re.rhs, "code", "indexed") }};
        yNew[{{ varn.y_names|length + varn.z_base[lhsExpr.operation.coordinate.id] }}] = __rumocaVal;
        __rumocaAssignSymbol("{{ q(dae.variables[lhsExpr.operation.coordinate.id].name) }}", __rumocaVal);
      }
      {%- elif lhsExpr.operation.kind == "index" and dae.expressions[lhsExpr.operation.base].operation.kind == "coordinate" and dae.expressions[lhsExpr.operation.base].operation.coordinate.kind == "discrete_real" %}
      {
        const __rumocaCoord = dae.expressions[lhsExpr.operation.base].operation.coordinate;
        const __rumocaOffset = {{ flat_subscript_offset(lhsExpr.operation.subscripts, lhsExpr.value_type.dimensions, "code", "indexed") }};
        const __rumocaVal = {{ render_expr(re.rhs, "code", "indexed") }};
        yNew[{{ varn.y_names|length + varn.z_base[__rumocaCoord.id] }} + __rumocaOffset] = __rumocaVal;
        __rumocaAssignSymbol("{{ q(dae.variables[__rumocaCoord.id].name) }}", __rumocaVal);
      }
      {%- else %}
      __rumocaUnsupported("discrete-residual-target");
      {%- endif %}
      {%- else %}
      __rumocaUnsupported("discrete-residual");
      {%- endif %}
    }
    {%- endfor %}

    {%- for action in dae.systems.events.actions %}
    if (!cPrev[{{ action.guard }}] && cCurr[{{ action.guard }}]) {
      {%- if action.operation.kind == "reinitialize" %}
      {
        const __rumocaVal = {{ render_expr(action.operation.value, "code", "indexed") }};
        xNew[{{ varn.x_base[action.operation.state] }}] = __rumocaVal;
        __rumocaAssignSymbol("{{ q(dae.variables[action.operation.state].name) }}", __rumocaVal);
      }
      {%- else %}
      __rumocaUnsupported("event-action:{{ action.operation.kind }}");
      {%- endif %}
    }
    {%- endfor %}

    const __rumocaCanCommitPre =
      !Number.isFinite(__rumocaLastPreCommitTime) ||
      Math.abs(Number(t) - Number(__rumocaLastPreCommitTime)) > __rumocaTimeTol;
    if (__rumocaCanCommitPre) {
    {%- for v in dae.variables %}
    {%- if v.role == "state" %}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
    {%- for i in range(count) %}
      __rumocaPreStore["{{ q(varn.x_names[varn.x_base[v.id] + i]) }}"] = xNew[{{ varn.x_base[v.id] + i }}];
    {%- endfor %}
    {%- elif v.role == "algebraic" %}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
    {%- for i in range(count) %}
      __rumocaPreStore["{{ q(varn.y_names[varn.y_base[v.id] + i]) }}"] = yNew[{{ varn.y_base[v.id] + i }}];
    {%- endfor %}
    {%- elif v.role == "discrete_real" %}
    {%- set slot = varn.y_names|length + varn.z_base[v.id] %}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
    {%- for i in range(count) %}
      __rumocaPreStore["{{ q(varn.z_names[varn.z_base[v.id] + i]) }}"] = yNew[{{ slot + i }}];
    {%- endfor %}
    {%- elif v.role == "discrete_value" %}
    {%- set slot = varn.y_names|length + varn.z_names|length + varn.m_base[v.id] %}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
    {%- for i in range(count) %}
      __rumocaPreStore["{{ q(varn.m_names[varn.m_base[v.id] + i]) }}"] = yNew[{{ slot + i }}];
    {%- endfor %}
    {%- elif v.role == "output" %}
    {%- set slot = varn.y_names|length + varn.z_names|length + varn.m_names|length + varn.w_base[v.id] %}
    {%- set count = v.scalar_count if v.scalar_count is not none else 1 %}
    {%- for i in range(count) %}
      __rumocaPreStore["{{ q(varn.w_names[varn.w_base[v.id] + i]) }}"] = yNew[{{ slot + i }}];
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
      __rumocaLastPreCommitTime = Number(t);
    }

    __rumocaRuntimeOverrides = null;
    return { x: xNew, y: yNew, c: cNew };
  }

  {%- if reduction.enabled %}
  // Execute certified assignments during every trial state, including Newton probes.
  function solveValues(t, X, PIn) {
    const sy = new Array({{ solve.layout.y_scalars }}).fill(0);
    const sp = new Array({{ solve.layout.p_scalars }}).fill(0);
    const supplied = Array.isArray(PIn) ? PIn : (PIn && Array.isArray(PIn.P) ? PIn.P : P_DEFAULT);
    {%- for name in varn.x_names %}
    sy[{{ varn.x_solve_slots[loop.index0] }}] = X[{{ loop.index0 }}];
    {%- endfor %}
    {%- for v in dae.variables %}
    {%- if v.role == 'parameter' %}
    {%- for i in range(v.scalar_count) %}
    sp[{{ solve.layout.bindings[v.name].P.index + i }}] = supplied[{{ varn.p_base[v.id] + i }}];
    {%- endfor %}
    {%- endif %}
    {%- endfor %}
    {%- for index in solve.continuous.exact_algebraic_assignments.sequence %}
    {%- if solve.continuous.exact_algebraic_assignments.plan.programs|length > 0 %}
    {
      {%- for op in solve.continuous.exact_algebraic_assignments.plan.programs[index].ops %}
      {{ solve_op(op, 'sy') }}
      {%- endfor %}
    }
    {%- endif %}
    {%- endfor %}
    return { sy, sp };
  }

  function solveAlgebraics(t, X, Y, U, PIn) {
    const { sy } = solveValues(t, X, PIn);
    return [
      {%- for name in varn.y_names %}
      sy[{{ varn.y_solve_slots[loop.index0] }}],
      {%- endfor %}
    ];
  }

  function solveResidual(t, X, XDot, Y, U, PIn) {
    const { sy, sp } = solveValues(t, X, PIn);
    const derivatives = new Array({{ solve.solve_layout.state_scalar_count }}).fill(0);
    {%- for program in solve.continuous.derivative_rhs.scalar_plan.programs %}
    {
      {%- for op in program.ops %}
      {{ solve_op(op, 'derivatives') }}
      {%- endfor %}
    }
    {%- endfor %}
    return [
      {%- for name in varn.x_names %}
      XDot[{{ loop.index0 }}] - derivatives[{{ varn.x_solve_slots[loop.index0] }}],
      {%- endfor %}
    ];
  }
  meta.solverAlgebraics = [];
  meta.summary.neqs = x0.length;
  {%- endif %}

  const abiRequired = true;
  const abi = { id: 'rumoca.model_runtime.residual.v1', version: 1 };
  if (Array.isArray(y0) && y0.length > 0) {
    try {
      const __rumocaInferredY0 = evalAlgebraics(
        0,
        x0.slice(),
        y0.slice(),
        new Array(meta.inputs.length).fill(0),
        null,
      );
      if (Array.isArray(__rumocaInferredY0) && __rumocaInferredY0.length === y0.length) {
        for (let i = 0; i < y0.length; i++) {
          const __rumocaValue = __rumocaInferredY0[i];
          if (typeof __rumocaValue === 'boolean' || (typeof __rumocaValue === 'number' && Number.isFinite(__rumocaValue))) {
            y0[i] = __rumocaValue;
          }
        }
      }
    } catch (_err) {
      // Keep declared starts when inference is not evaluable at model construction.
    }
  }
  const description = {
    modelName: meta.name,
    variables: []
      .concat(meta.parameters.map((v) => ({ name: v.name, kind: 'parameter', start: v.start, unit: v.unit })))
      .concat(meta.constants.map((v) => ({ name: v.name, kind: 'constant', start: v.value, unit: v.unit })))
      .concat(meta.states.map((v) => ({ name: v.name, kind: 'state', start: v.start, unit: v.unit })))
      .concat(meta.algebraics.map((v) => ({ name: v.name, kind: 'algebraic', start: v.start, unit: v.unit })))
      .concat(meta.inputs.map((v) => ({ name: v.name, kind: 'input', unit: v.unit }))),
    nx: meta.summary.nx,
    ny: {{ "0" if reduction.enabled else "meta.summary.ny" }},
    nu: meta.inputs.length,
    nz: {{ dae.systems.conditions.conditions|length }}
  };
  const capabilities = { events: {{ "true" if n_events > 0 else "false" }}, algebraics: {{ "true" if ny_var > 0 else "false" }} };

  return {
    abiRequired,
    abi,
    description,
    capabilities,
    name: meta.name,
    meta,
    x0,
    y0: {{ "[]" if reduction.enabled else "y0" }},
    c0,
    residual: {{ "solveResidual" if reduction.enabled else "residual" }},
    evalAlgebraics: {{ "solveAlgebraics" if reduction.enabled else "evalAlgebraics" }},
    evalEventIndicators,
    evalConditions,
    applyResets,
    configureDebug: __rumocaConfigureDebug,
    getDebugEvents: () => __rumocaEventLog.slice(),
    clearDebugEvents: () => {
      __rumocaEventLog = [];
    },
  };
}
