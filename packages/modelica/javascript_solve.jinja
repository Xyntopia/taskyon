          const program=structuredPrograms.find(program=>program.indices.includes(row));
          if(!program)throw new Error('Issued event row has no producing program');
          add(target,'assignment',row,program);
        }
      if(!rows.some(row=>row.kind==='assignment'))throw new Error('Stalled event equations have no Real targets for coupled recovery');
      const read=target=>target.Y?sy[target.Y.index]:sp[target.P.index];
      const scales=rows.map(({target})=>target.Y?(solverNominals[target.Y.index]||1):Math.max(1,Math.abs(read(target))));
      const result=solveNonlinear(coordinates=>{
        for(let i=0;i<rows.length;i++)write(rows[i].target,coordinates[i]);
        {%- if solve.discrete.runtime_assignment_plan.stored_output_count > 0 %}
        applyIssuedAssignments(t,sy,sp,runtimePrograms,runtimeTargets);
        {%- endif %}
        {%- if reduced and exact.plan.programs|length > 0 %}
        projectAlgebraicValues(t,sy,sp,solveNonlinear);
        {%- endif %}
        {%- if solve.events.delays.value_parameter_indices|length > 0 %}
        refreshDelays(t,sy,sp);
        {%- endif %}
        const implicit=[];
        {%- if not reduced %}
        {{ evaluate(solve.continuous.implicit_rhs.scalar_plan,'implicit',effects) }}
        {%- endif %}
        const cache=new Map();
        return rows.map(({target,kind,row,program})=>{
          if(kind==='implicit')return implicit[row];
          if(!cache.has(program))cache.set(program,program.evaluate(t,sy,sp));
          return read(target)-cache.get(program)[row];
        });
      },rows.map(({target})=>read(target)),scales);
      for(let i=0;i<rows.length;i++)write(rows[i].target,result[i]);
      {%- if solve.discrete.runtime_assignment_plan.stored_output_count > 0 %}
      applyIssuedAssignments(t,sy,sp,runtimePrograms,runtimeTargets);
      {%- endif %}
      {%- if reduced and exact.plan.programs|length > 0 %}
      projectAlgebraicValues(t,sy,sp,solveNonlinear);
      {%- endif %}
    }
    const fixedPointCap={{ solve.discrete.event_iteration_plan.schedule.fixed_point_cap }};
    let wholePass=0,settlePass=0;
    while(wholePass<fixedPointCap) {
      let changed=false;
      {%- if solve.events.delays.value_parameter_indices|length > 0 %}
      changed=refreshDelays(t,sy,sp)||changed;
      {%- endif %}
      {%- if solve.discrete.runtime_assignment_plan.stored_output_count > 0 %}
      changed=applyIssuedAssignments(t,sy,sp,runtimePrograms,runtimeTargets)||changed;
      {%- endif %}
      const output=[],guarded=[];
      for(const program of discretePrograms) {
        if(!program.indices.some(row=>clockOwners[row]===null&&!coveredRows.has(row)&&!isConditionMemory(rowRoles[row])))continue;
        const values=program.evaluate(t,sy,sp);
        for(const row of program.indices)if(clockOwners[row]===null&&!coveredRows.has(row)&&!isConditionMemory(rowRoles[row]))output[row]=values[row];
      }
      for(let i=0;i<guardedPrograms.length;i++)if(guardedOwners[i]===null&&!coveredGuarded.has(i)) {
        const program=guardedPrograms[i],values=program.evaluate(t,sy,sp);
        for(const row of program.indices)guarded[row]=values[row];
      }
      const structuredWrites=[],cache=new Map();
      for(let i=0;i<structuredAssignments.length;i++)if(structuredClockOwners[i]===null&&!coveredStructured.has(i)&&!isConditionMemory(structuredRoles[i])) {
        for(const [target,row] of structuredAssignments[i]) {
          const program=structuredPrograms.find(program=>program.indices.includes(row));
          if(!program)throw new Error('Issued structured row has no producing program');
          if(!cache.has(program))cache.set(program,program.evaluate(t,sy,sp));
          structuredWrites.push([target,cache.get(program)[row]]);
        }
      }
      for(let i=0;i<targets.length;i++)if(output[i]!==undefined)changed=write(targets[i],output[i])||changed;
      for(let i=0;i<guardedTargets.length;i++)if(guarded[i]!==undefined)changed=write(guardedTargets[i],guarded[i])||changed;
      for(const [target,value] of structuredWrites)changed=write(target,value)||changed;
      if(changed) {
        {%- if (reduced and exact.plan.programs|length > 0) or (not reduced and projection.algebraic|length > 0) %}
      projectAlgebraicValues(t,sy,sp,solveNonlinear);
      {%- endif %}
        if(++settlePass>=fixedPointCap)recoverEventEquations();
        else continue;
      }
      {%- if 'AlgebraicDependent' in solve.events.root_relation_refresh_roles %}
      if(refreshRelations()) {
        if(++relationPass>=fixedPointCap)throw new Error('Checked algebraic relations did not settle');
        if(resolveRelationCycle()) {settlePass=0;continue;}
      }
      relationPass=0;relationHistory.length=0;
      {%- endif %}
      const conditionWrites=[];
      for(const program of discretePrograms) {
        const rows=program.indices.filter(row=>isConditionMemory(rowRoles[row])&&(clockOwners[row]===null||active[clockOwners[row]]!==undefined));
        if(!rows.length)continue;
        const output=program.evaluate(t,sy,sp);
        for(const row of rows)conditionWrites.push([targets[row],output[row]]);
      }
      for(let i=0;i<structuredAssignments.length;i++)if(isConditionMemory(structuredRoles[i])&&(structuredClockOwners[i]===null||active[structuredClockOwners[i]]!==undefined)) {
        for(const [target,row] of structuredAssignments[i]) {
          const program=structuredPrograms.find(program=>program.indices.includes(row));
          if(!program)throw new Error('Issued structured history has no producing program');
          conditionWrites.push([target,program.evaluate(t,sy,sp)[row]]);
        }
      }
      let historyChanged=false;
      for(const [target,value] of conditionWrites)historyChanged=write(target,value)||historyChanged;
      historyChanged=advanceOrdinaryEventHistory()||historyChanged;
      if(historyChanged) {wholePass++;settlePass=0;continue;}
      {
        const actionP=sp.slice();
        for(const index of {{ solve.events.condition_memory_parameter_indices|tojson }})actionP[index]=eventEntryP[index];
        const report=actionsAt(t,sy,actionP,transactionActions);
        pendingActionReport={warnings:[...(pendingActionReport?.warnings||[]),...report.warnings],termination:report.termination??pendingActionReport?.termination};
        const postEventP=sp.slice();
        for(let i=0;i<preBindings.length;i++)if(!clockHistorySchedules[i]||activeClockIndex(clockHistorySchedules[i],t)!==undefined) {
          const binding=preBindings[i];
          sp[binding.dest_p_index]=binding.source.Y?sy[binding.source.Y.index]:postEventP[binding.source.P.index];
        }
        for(const slot of activationSlots)sp[slot]=0;
        const pulseWrites=[];
        for(const program of discretePrograms) {
          const rows=program.indices.filter(row=>rowRoles[row]==='PulseConditionMemory');
          if(!rows.length)continue;
          const output=program.evaluate(t,sy,sp);
          for(const row of rows)pulseWrites.push([targets[row],output[row]]);
        }
        for(const [target,value] of pulseWrites)write(target,value);
        {%- if solve.discrete.post_commit_assignment_plan.stored_output_count > 0 %}
        applyIssuedAssignments(t,sy,sp,postCommitPrograms,postCommitTargets);
        {%- endif %}
        for(let i=0;i<sp.length;i++)initialP[i]=sp[i];
        for(let i=0;i<active.length;i++)if(active[i]!==undefined)clockStates[i].consumed=active[i];
        return {x:sy.slice(0,nx),y:{{ '[]' if reduced else 'sy.slice(nx)' }},c:current.slice()};
      }
    }
    throw new Error('Solve event iteration did not settle');
    } catch(error) {impureRandomStreams=randomBefore;throw error;}
  }
  {%- endif %}

  {%- if solve.events.has_terminal_event %}
  function beginTerminalEvent() {
    initialP[{{ solve.solve_layout.terminal_event_parameter_index }}]=1;
  }
  {%- endif %}

  function finishInitialization() {
    {%- if solve.solve_layout.initial_event_parameter_index is not none %}
    initialP[{{ solve.solve_layout.initial_event_parameter_index }}]=0;
    {%- endif %}
  }

  // Format binary64 through exact rational decimal rounding, including ties to even.
  // JS toFixed/toPrecision cap precision at 100; Modelica's checked profile permits 1024.
  function roundedDecimal(value, places) {
    const buffer=new ArrayBuffer(8),view=new DataView(buffer);
    view.setFloat64(0,Math.abs(value));
    const bits=view.getBigUint64(0),exponent=Number((bits>>52n)&2047n);
    const mantissa=(bits&((1n<<52n)-1n))+(exponent===0?0n:1n<<52n);
    const shift=exponent===0?-1074:exponent-1075;
    let numerator=mantissa,denominator=1n;
    if(shift>=0)numerator<<=BigInt(shift);else denominator<<=BigInt(-shift);
    if(places>=0)numerator*=10n**BigInt(places);else denominator*=10n**BigInt(-places);
    let rounded=numerator/denominator;
    const remainder=numerator%denominator;
    if(remainder*2n>denominator||(remainder*2n===denominator&&rounded%2n!==0n))rounded++;
    return rounded;
  }
  function utf8Length(text) {
    let length=0;
    for(const character of text) {
      const code=character.codePointAt(0);
      length+=code<=0x7f?1:code<=0x7ff?2:code<=0xffff?3:4;
    }
    return length;
  }
  function formatReal(value,digits) {
    if(!Number.isFinite(value))return Number.isNaN(value)?'NaN':(value<0?'-inf':'inf');
    if(value===0)return Object.is(value,-0)?'-0':'0';
    const sign=value<0?'-':'',exponent=Math.floor(Math.log10(Math.abs(value)));
    const trim=text=>text.includes('.')?text.replace(/0+$/,'').replace(/\.$/,''):text;
    if(exponent < -4 || exponent>=digits) {
      let e=exponent,rounded=roundedDecimal(value,digits-1-e).toString();
      if(rounded.length>digits){rounded=rounded.slice(0,-1);e++;}
      rounded=rounded.padStart(digits,'0');
      const mantissa=digits===1?rounded:rounded[0]+'.'+rounded.slice(1);
      return sign+trim(mantissa)+'e'+e;
    }
    const places=Math.max(0,digits-exponent-1),rounded=roundedDecimal(value,places).toString().padStart(places+1,'0');
    return sign+trim(places===0?rounded:rounded.slice(0,-places)+'.'+rounded.slice(-places));
  }
  function formatMessageConversion(value,source,width,left,digits) {
    for(const option of [width,digits])if(!Number.isInteger(option)||option < -9223372036854775808 || option>=9223372036854775808)throw new Error('Modelica String option must be an Integer');
    if(width<0||width>1048576||digits<1||digits>1024||(left!==0&&left!==1))throw new Error('Modelica String option out of range');
    let text;
    if(source==='real')text=formatReal(value,digits);
    else if(source==='integer') {
      if(typeof value!=='bigint'&&(!Number.isFinite(value)||!Number.isInteger(value)))throw new Error('Modelica String Integer value is invalid');
      text=BigInt(value).toString();
    } else {
      if(value!==0&&value!==1)throw new Error('Modelica String Boolean value is invalid');
      text=value===1?'true':'false';
    }
    return left===1?text.padEnd(width,' '):text.padStart(width,' ');
  }

  const reportedWarnings=new Set();
  let pendingActionReport;
  function evaluateEventActions(t,X,Y,U,PIn) {
    if(pendingActionReport) {const report=pendingActionReport;pendingActionReport=undefined;return report;}
    const {sy,sp}=values(t,X,Y,U,PIn);
    return actionsAt(t,sy,sp);
  }
  function actionsAt(t,sy,sp,transactionActions=[]) {
    const output=[],warnings=[],warningSites=[],assertionObservations=[];
    {{ evaluate(solve.events.action_plan,'output',effects,'assertionObservations') }}
    for(let i=0;i<transactionActions.length;i++)if(transactionActions[i]!==undefined)output[i]=transactionActions[i];
    let termination;
    {%- for action in solve.events.actions %}
    if(output[{{ loop.index0 }}]>0.5{% if action.clock_owner is not none %} && sp[{{ solve.clocks.activation_parameter_indices[action.clock_owner] }}]!==0{% endif %}) {
      {%- if action.assertion_projection is not none %}
      const notices=assertionObservations.filter(notice=>notice.owner==={{ action.assertion_projection.site.owner }} && notice.predicate==={{ action.assertion_projection.predicate_output }});
      if(notices.length===0)throw new Error('Missing checked assertion observation');
      {%- else %}
      const notices=[null];
      {%- endif %}
      for(const notice of notices) {
      let message='';
      {%- if action.assertion_projection is not none %}
      {%- for part in action.message.parts %}
      {%- if part.Text is defined %}
      message+={{ part.Text|tojson }};
      {%- else %}
      {%- set conversion=part.Conversion %}
      {%- set options=conversion.format.Options %}
      message+=formatMessageConversion({{ assertion_capture(conversion.value,action.assertion_projection,conversion.source) if conversion.source == 'Integer' else 'Number(' ~ assertion_capture(conversion.value,action.assertion_projection,conversion.source) ~ ')' }},{{ conversion.source|lower|tojson }},
        {{ 'Number(' ~ assertion_capture(options.minimum_length,action.assertion_projection,'Integer') ~ ')' if options.minimum_length is not none else '0' }},
        {{ 'Number(' ~ assertion_capture(options.left_justified,action.assertion_projection,'Boolean') ~ ')' if options.left_justified is not none else '1' }},
        {{ 'Number(' ~ assertion_capture(options.significant_digits,action.assertion_projection,'Integer') ~ ')' if options.significant_digits is not none else '6' }});
      {%- endif %}
      if(utf8Length(message)>1048576)throw new Error('Modelica event message exceeds byte limit');
      {%- endfor %}
      {%- else %}
      {%- for part in solve.events.action_message_parts[loop.index0] %}
      {%- if part.text is defined %}
      message+={{ action.message.parts[loop.index0].Text|tojson }};
      {%- else %}
      { const messageValues=[];
        {%- set conversion=part.conversion %}
        {%- for row in [conversion.value,conversion.minimum_length,conversion.left_justified,conversion.significant_digits] %}
        {%- if row is not none %}
        { {{ operations(solve.events.action_message_plan.programs[row],'messageValues',effects) }} }
        {%- endif %}
        {%- endfor %}
        message+=formatMessageConversion(messageValues[{{ conversion.value }}],{{ conversion.source|tojson }},
          {{ 'messageValues[' ~ conversion.minimum_length ~ ']' if conversion.minimum_length is not none else '0' }},
          {{ 'messageValues[' ~ conversion.left_justified ~ ']' if conversion.left_justified is not none else '1' }},
          {{ 'messageValues[' ~ conversion.significant_digits ~ ']' if conversion.significant_digits is not none else '6' }});
      }
      {%- endif %}
      if(utf8Length(message)>1048576)throw new Error('Modelica event message exceeds byte limit');
      {%- endfor %}
      {%- endif %}
      {%- if action.kind == 'Assert' %}
      throw new Error('Modelica assertion failed: '+message);
      {%- elif action.kind == 'Warning' %}
      if(!reportedWarnings.has({{ loop.index0 }}) && !warningSites.includes({{ loop.index0 }})) {warningSites.push({{ loop.index0 }});warnings.push(message);}
      {%- elif action.kind == 'Terminate' %}
      termination=message;
      {%- endif %}
      }
    }
    {%- endfor %}
    for(const site of warningSites)reportedWarnings.add(site);
    return {warnings,termination};
  }

  function nextTimeEvent(t,X,Y,U,PIn) {
    const {sy,sp}=values(t,X,Y,U,PIn),dynamic=[];
    {{ evaluate(solve.events.dynamic_time_event_plan,'dynamic',effects) }}
    let next;
    for(const deadline of [...{{ solve.events.scheduled_time_events|tojson }},...dynamic,...clockStates.map(clock=>nextClockTime(clock,t))]) {
      if(!Number.isFinite(deadline))continue;
      if(deadline>t && (next===undefined||deadline<next))next=deadline;
    }
    return next;
  }

  function residual(t, X, XDot, Y, U, PIn) {
    const { sy, sp } = values(t, X, Y, U, PIn);
    const derivatives = new Array(nx).fill(0);
    {{ evaluate(solve.continuous.derivative_rhs.scalar_plan, 'derivatives',effects) }}
    const result = derivatives.map((value, i) => XDot[i]-value);
    {%- if not reduced %}
    const implicit = [];
    {{ evaluate(solve.continuous.implicit_rhs.scalar_plan, 'implicit',effects) }}
    {%- for block in projection.algebraic %}
    {%- for row in block.rows %}
    result.push(implicit[{{ row }}]);
    {%- endfor %}
    {%- endfor %}
    {%- endif %}
    return result;
  }

  // These checked programs differentiate RHS rows in full solver-Y/P coordinates.
  // Algebraic directions are explicit here; the projected callback below solves them.
  function evalSolveJacobianVector(t,X,Y,U,PIn,directions) {
    const {sy,sp}=values(t,X,Y,U,PIn);
    for (const [values,count] of [[directions.solverY,names.length],[directions.parameters,parameters.length],[directions.inputs,inputs.length]]) {
      if(!Array.isArray(values)||values.length!==count||values.some(value=>!Number.isFinite(value))) throw new Error('Solve tangent layout mismatch');
    }
    const seed=new Array(names.length+initialP.length).fill(0);
    for(let i=0;i<names.length;i++)seed[i]=directions.solverY[i];
    for(let i=0;i<parameters.length;i++)seed[names.length+parameters[i].slot]=directions.parameters[i];
    for(let i=0;i<inputs.length;i++)seed[names.length+inputs[i].slot]=directions.inputs[i];
    const derivativeRhs=[],implicitResidual=[];
    {{ evaluate(solve.artifacts.continuous.full_jacobian_plan,'derivativeRhs',effects) }}
    {{ evaluate(solve.artifacts.continuous.implicit_full_jacobian_plan,'implicitResidual',effects) }}
    return {derivativeRhs,implicitResidual};
  }

  // At a consistent primal point, project the direction through Rumoca's algebraic blocks.
  function evalProjectedJacobianVector(t,X,Y,U,PIn,directions) {
    if(!Array.isArray(directions.state)||directions.state.length!==nx) throw new Error('Solve state tangent layout mismatch');
    const solverY=new Array(names.length).fill(0);
    for(let i=0;i<nx;i++)solverY[i]=directions.state[i];
    const tangent={solverY,parameters:directions.parameters,inputs:directions.inputs};
    for(const block of {{ projection.algebraic|tojson }}) {
      const count=block.y_indices.length;
      const residual=evalSolveJacobianVector(t,X,Y,U,PIn,tangent).implicitResidual;
      const matrix=new Array(count*count).fill(0);
      for(let column=0;column<count;column++) {
        const basis=new Array(names.length).fill(0);basis[block.y_indices[column]]=1;
        const result=evalSolveJacobianVector(t,X,Y,U,PIn,{solverY:basis,parameters:new Array(parameters.length).fill(0),inputs:new Array(inputs.length).fill(0)}).implicitResidual;
        for(let row=0;row<count;row++)matrix[row*count+column]=result[block.rows[row]];
      }
      const correction=linearSolve(matrix,block.rows.map(row=>-residual[row]));
      for(let i=0;i<count;i++)solverY[block.y_indices[i]]+=correction[i];
    }
    const result=evalSolveJacobianVector(t,X,Y,U,PIn,tangent);
    return {solverY,derivativeRhs:result.derivativeRhs};
  }

  function evalAlgebraics(t, X, Y, U, PIn) {
    const {sy,sp}=values(t,X,Y,U,PIn);
    return observe(t,sy,sp);
  }

  {%- if projection.manifold|length > 0 %}
  // Retained index-reduction constraints. `manifold_residual` and its solver-Y
  // JVP are checked programs; the shared runtime owns the scaled minimum-norm
  // Newton iteration that reprojects every accepted state back onto them.
  function evalManifoldResidual(t, X, Y, U, PIn) {
    const {sy,sp}=values(t,X,Y,U,PIn);
    const manifold=[];
    {{ evaluate(solve.continuous.manifold_residual.scalar_plan,'manifold',effects) }}
    return manifold;
  }
  function evalManifoldJacobianVector(t, X, Y, U, PIn, direction) {
    const {sy,sp}=values(t,X,Y,U,PIn);
    const seed=new Array(names.length+initialP.length).fill(0);
    for(let i=0;i<nx;i++)seed[i]=direction[i];
    const manifoldJacobian=[];
    {{ evaluate(solve.artifacts.continuous.manifold_jacobian_v.scalar_plan,'manifoldJacobian',effects) }}
    return manifoldJacobian;
  }
  function projectStateManifold(t, X, Y, U, PIn, project) {
    // Rumoca's `solver_variable_scale`: the declared nominal when finite and
    // positive, raised to the initial magnitude so large starts keep a
    // meaningful projection scale.
    const scales=new Array(nx);
    for(let i=0;i<nx;i++) {
      const nominal=Number.isFinite(solverNominals[i])&&solverNominals[i]>0?solverNominals[i]:1;
      scales[i]=Math.max(nominal,Math.abs(initialY[i]));
    }
    const projected=project(
      coordinates=>evalManifoldResidual(t,coordinates,Y,U,PIn),
      (coordinates,direction)=>evalManifoldJacobianVector(t,coordinates,Y,U,PIn,direction),
      X,
      scales,
    );
    return {x:projected,y:Y};
  }
  {%- endif %}

  const description = {
    modelName: meta.name, nx, ny: y0.length, nu: inputs.length, nz: {{ solve.events.root_plan.output_count + solve.events.delays.value_parameter_indices|length }},
    variables: [
      ...meta.states.map(v => ({ name:v.name, kind:'state', start:v.start })),
      ...meta.algebraics.map(v => ({ name:v.name, kind:'algebraic', start:v.start })),
      ...parameters.map(v => ({ name:v.name, kind:'parameter', start:v.start })),
      ...inputs.map(v => ({ name:v.name, kind:'input', start:v.start })),
      ...constants.map(v => ({ name:v.name, kind:'constant', start:v.value })),
    ],
  };
  return {
    abiRequired: true,
    abi: { id:'rumoca.model_runtime.residual.v1', version:1 },
    description, capabilities: { events:{{ 'true' if has_events else 'false' }}, algebraics: observationNames.length > 0 },
    name: meta.name, meta, x0, y0, residual, evalAlgebraics, evaluateEventActions,
    {%- if solve.events.delays.value_parameter_indices|length == 0 and not effects.impure %}
    evalSolveJacobianVector, evalProjectedJacobianVector,
    {%- endif %}
    {%- if has_events %}
    evalEventIndicators,evalConditions,applyResets,
    {%- endif %}
    initialize,finishInitialization,nextTimeEvent,
    {%- if not reduced and projection.algebraic|length > 0 %}
    projectAlgebraics,
    {%- endif %}
    {%- if projection.manifold|length > 0 %}
    projectStateManifold,
    {%- endif %}
    {%- if solve.events.delays.value_parameter_indices|length > 0 or effects.impure %}
    checkpointRuntime,
    {%- endif %}
    {%- if solve.events.delays.value_parameter_indices|length > 0 %}
    commitAcceptedStep,maxAcceptedStep,
    {%- endif %}
    {%- if solve.events.has_terminal_event %}
    beginTerminalEvent,
    {%- endif %}
  };
}
