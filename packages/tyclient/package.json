{
  "name": "@taskyon/tyclient",
  "version": "0.5.3",
  "license": "MIT",
  "main": "./dist/tyclient.js",
  "module": "./dist/tyclient.mjs",
  "types": "./dist/tyclient.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tyclient.d.ts",
      "import": "./dist/tyclient.mjs",
      "require": "./dist/tyclient.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@taskyon/common": "workspace:*",
    "@taskyon/taskyon": "workspace:*"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "esbuild": "0.28.1",
    "tsup": "^8.5.0",
    "type-fest": "^4.30.1",
    "vite": "^7.3.6"
  },
  "scripts": {
    "build": "tsup",
    "build:vite:notworking": "vite build --config vite.lib.config.ts",
    "prepack": "yarn build"
  }
}
