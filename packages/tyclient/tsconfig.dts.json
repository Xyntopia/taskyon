{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "preserveSymlinks": true,

    "baseUrl": ".",

    // ✅ let TS compute a common root across tyclient + taskyon
    //    (drop rootDir entirely)
    // "rootDir": ".",

    // or, if you prefer explicit multi-root:
    "rootDirs": ["./"],

    "paths": {
      //"src/*": ["../../src/*"],
      //"@taskyon/taskyon": ["../taskyon/src/index.ts"],
      "@taskyon/taskyon/api": ["../taskyon/src/api/index.ts"]
    },

    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable"],
    "types": []
  }
}
