{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "preserveSymlinks": true,

    "baseUrl": ".",

    // ✅ let TS compute a common root across tyclient + taskyon
    //    (drop rootDir entirely)
    // "rootDir": ".",

    // or, if you prefer explicit multi-root:
    "rootDirs": ["./", "../taskyon"],

    "paths": {
      "src/*": ["../../src/*"],
      "@taskyon/taskyon": ["../taskyon/src/index.ts"],
      "@taskyon/taskyon/*": ["../taskyon/src/*"]
    }
  },
  "include": ["src/**/*", "../taskyon/src/**/*"]
}
