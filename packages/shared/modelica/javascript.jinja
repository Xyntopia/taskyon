  {%- for (name, comp) in cp_map|items %}
    const {{ js_ident(name) }} = constants["{{ name }}"];
  {%- endfor %}

  {%- for (name, comp) in x_map|items %}
    const {{ js_ident(name) }} = xVec[{{ loop.index0 }}];
  {%- endfor %}

  {%- for (name, comp) in y_map|items %}
    const {{ js_ident(name) }} = yVec[{{ loop.index0 }}];
  {%- endfor %}
  {%- for (name, comp) in z_map|items %}
    const {{ js_ident(name) }} = yVec[{{ y_map|length + loop.index0 }}];
  {%- endfor %}
  {%- for (name, comp) in m_map|items %}
    const {{ js_ident(name) }} = yVec[{{ y_map|length + z_map|length + loop.index0 }}];
  {%- endfor %}
  {%- for (name, comp) in w_map|items %}
    const {{ js_ident(name) }} = yVec[{{ y_map|length + z_map|length + m_map|length + loop.index0 }}];
  {%- endfor %}

  {%- for (name, comp) in u_map|items %}
    const {{ js_ident(name) }} = uVec[{{ loop.index0 }}];
  {%- endfor %}

    let xNew = xVec.slice();
    let yNew = yVec.slice();
    let cNew = Array.isArray(cCurr) ? cCurr.slice() : [];

  {%- for wc in when_clauses %}
    {
      const idx = {{ loop.index0 }};
      const fired = !cPrev[idx] && cCurr[idx];
      if (fired) {
        {%- for eq in wc.equations %}
        {%- if eq.lhs is defined %}
        {%- set lhs_name = render_symbol_name(eq.lhs)|trim %}
        {
          const __rumocaAssigned = {{ render_expr(eq.rhs) }};
          if (stateIndex["{{ lhs_name }}"] !== undefined) {
            xNew[stateIndex["{{ lhs_name }}"]] = __rumocaAssigned;
          } else if (algebraicIndex["{{ lhs_name }}"] !== undefined) {
            yNew[algebraicIndex["{{ lhs_name }}"]] = __rumocaAssigned;
          }
          __rumocaAssignSymbol("{{ lhs_name }}", __rumocaAssigned);
        }
        
        {%- endif %}
        {%- endfor %}
      }
    }
  {%- endfor %}

  {%- if when_clauses|length == 0 and reset_eqs|length > 0 %}
    const __rumocaFallbackWhenFired =
      Array.isArray(cPrev) &&
      Array.isArray(cCurr) &&
      cCurr.some((value, idx) => Boolean(value) && !Boolean(cPrev[idx]));
    {# Pass 1: propagate direct wiring first (lhs = rhs VarRef/ComponentReference). #}
    {%- for eq in reset_eqs %}
      {%- if eq.lhs is defined and eq.rhs is defined and (eq.rhs.VarRef is defined or eq.rhs.ComponentReference is defined) %}
      {%- set lhs_name = render_symbol_name(eq.lhs)|trim %}
      {
        const __rumocaIsStateTarget = stateIndex["{{ lhs_name }}"] !== undefined;
        const __rumocaApplyResetEq = __rumocaIsStateTarget ? __rumocaFallbackWhenFired : true;
        if (__rumocaApplyResetEq) {
        const __rumocaAssigned = {{ render_expr(eq.rhs) }};
        if (stateIndex["{{ lhs_name }}"] !== undefined) {
          xNew[stateIndex["{{ lhs_name }}"]] = __rumocaAssigned;
        } else if (algebraicIndex["{{ lhs_name }}"] !== undefined) {
          yNew[algebraicIndex["{{ lhs_name }}"]] = __rumocaAssigned;
        }
        __rumocaAssignSymbol("{{ lhs_name }}", __rumocaAssigned);
        }
      }
      {%- endif %}
    {%- endfor %}
    {# Pass 2: evaluate remaining reset/discrete expressions. #}
    {%- for eq in reset_eqs %}
      {%- if eq.lhs is defined and not (eq.rhs is defined and (eq.rhs.VarRef is defined or eq.rhs.ComponentReference is defined)) %}
      {%- set lhs_name = render_symbol_name(eq.lhs)|trim %}
      {
        const __rumocaIsStateTarget = stateIndex["{{ lhs_name }}"] !== undefined;
        const __rumocaApplyResetEq = __rumocaIsStateTarget ? __rumocaFallbackWhenFired : true;
        if (__rumocaApplyResetEq) {
        const __rumocaAssigned = {{ render_expr(eq.rhs) }};
        if (stateIndex["{{ lhs_name }}"] !== undefined) {
          xNew[stateIndex["{{ lhs_name }}"]] = __rumocaAssigned;
        } else if (algebraicIndex["{{ lhs_name }}"] !== undefined) {
          yNew[algebraicIndex["{{ lhs_name }}"]] = __rumocaAssigned;
        }
        __rumocaAssignSymbol("{{ lhs_name }}", __rumocaAssigned);
        }
      }
      {%- endif %}
    {%- endfor %}
  {%- endif %}

    const __rumocaCanCommitPre =
      !Number.isFinite(__rumocaLastPreCommitTime) ||
      Math.abs(Number(t) - Number(__rumocaLastPreCommitTime)) > __rumocaTimeTol;
    if (__rumocaCanCommitPre) {
    {%- for (name, comp) in x_map|items %}
      if (stateIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = xNew[stateIndex["{{ name }}"]];
      } else if (algebraicIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = yNew[algebraicIndex["{{ name }}"]];
      }
    {%- endfor %}
    {%- for (name, comp) in y_map|items %}
      if (stateIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = xNew[stateIndex["{{ name }}"]];
      } else if (algebraicIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = yNew[algebraicIndex["{{ name }}"]];
      }
    {%- endfor %}
    {%- for (name, comp) in z_map|items %}
      if (stateIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = xNew[stateIndex["{{ name }}"]];
      } else if (algebraicIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = yNew[algebraicIndex["{{ name }}"]];
      }
    {%- endfor %}
    {%- for (name, comp) in m_map|items %}
      if (stateIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = xNew[stateIndex["{{ name }}"]];
      } else if (algebraicIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = yNew[algebraicIndex["{{ name }}"]];
      }
    {%- endfor %}
    {%- for (name, comp) in w_map|items %}
      if (stateIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = xNew[stateIndex["{{ name }}"]];
      } else if (algebraicIndex["{{ name }}"] !== undefined) {
        __rumocaPreStore["{{ name }}"] = yNew[algebraicIndex["{{ name }}"]];
      }
    {%- endfor %}
      __rumocaLastPreCommitTime = Number(t);
    }

    __rumocaRuntimeOverrides = null;
    return { x: xNew, y: yNew, c: cNew };
  }

  const abiRequired = true;
  const abi = { id: 'rumoca.model_runtime.residual.v1', version: 1 };
  if (typeof evalAlgebraics === 'function' && Array.isArray(y0) && y0.length > 0) {
    try {
      const __rumocaY0HadFinite = y0.some(
        (v) => typeof v === 'number' && Number.isFinite(v),
      );
      const __rumocaInferredY0 = evalAlgebraics(
        0,
        x0.slice(),
        y0.slice(),
        new Array(meta.inputs.length).fill(0),
        null,
      );
      if (Array.isArray(__rumocaInferredY0) && __rumocaInferredY0.length === y0.length) {
        const __rumocaInferredAllZero = __rumocaInferredY0.every(
          (v) => typeof v === 'number' && Number.isFinite(v) && Math.abs(v) <= 0,
        );
        const __rumocaAcceptInferred = __rumocaY0HadFinite || !__rumocaInferredAllZero;
        if (__rumocaAcceptInferred) {
        for (let i = 0; i < y0.length; i++) {
          const __rumocaValue = __rumocaInferredY0[i];
          if (typeof __rumocaValue === 'boolean' || (typeof __rumocaValue === 'number' && Number.isFinite(__rumocaValue))) {
            y0[i] = __rumocaValue;
          }
        }
        }
      }
    } catch (_err) {
      // Keep declared starts when inference is not evaluable at model construction.
    }
  }
  const description = {
    modelName: meta.name,
    variables: []
      .concat(meta.parameters.map((v) => ({ name: v.name, kind: 'parameter', start: v.start, unit: v.unit })))
      .concat(meta.constants.map((v) => ({ name: v.name, kind: 'constant', start: v.value, unit: v.unit })))
      .concat(meta.states.map((v) => ({ name: v.name, kind: 'state', start: v.start, unit: v.unit })))
      .concat(meta.algebraics.map((v) => ({ name: v.name, kind: 'algebraic', start: v.start, unit: v.unit })))
      .concat(meta.inputs.map((v) => ({ name: v.name, kind: 'input', unit: v.unit }))),
    nx: meta.summary.nx,
    ny: meta.summary.ny,
    nu: meta.inputs.length,
    nz: {{ cond_eqs|length }}
  };
  const capabilities = { events: {{ "true" if cond_eqs|length > 0 or when_clauses|length > 0 or reset_eqs|length > 0 else "false" }} };

  return {
    abiRequired,
    abi,
    description,
    capabilities,
    name: meta.name,
    meta,
    x0,
    y0,
    c0,
    residual,
    evalAlgebraics,
    evalEventIndicators,
    evalConditions,
    applyResets,
    configureDebug: __rumocaConfigureDebug,
    getDebugEvents: () => __rumocaEventLog.slice(),
    clearDebugEvents: () => {
      __rumocaEventLog = [];
    },
  };
}
