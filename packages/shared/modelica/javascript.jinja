{# -------------------------------------------------------------------------
 # JS generator for Rumoca DAE JSON.
 # Supports both legacy and redesign_v3 DAE field naming.
 # ------------------------------------------------------------------------- #}

{%- set model_name = dae.model_name if dae.model_name is defined else "GeneratedModel" -%}
{%- set p_map = dae.p if dae.p is defined else {} -%}
{%- set cp_map = dae.constants if dae.constants is defined else (dae.cp if dae.cp is defined else {}) -%}
{%- set x_map = dae.x if dae.x is defined else {} -%}
{%- set y_map = dae.y if dae.y is defined else {} -%}
{%- if dae.__rumoca_observables is defined -%}
{%- set obs_list = dae.__rumoca_observables -%}
{%- else -%}
{%- set obs_list = [] -%}
{%- endif -%}
{%- set u_map = dae.u if dae.u is defined else {} -%}
{%- set w_map = dae.w if dae.w is defined else {} -%}
{%- set z_map = dae.z if dae.z is defined else {} -%}
{%- set m_map = dae.m if dae.m is defined else {} -%}
{%- set x_dot_alias_map = dae.x_dot_alias if dae.x_dot_alias is defined else {} -%}
{%- set emit_generated_expr_comments = dae.__rumoca_emit_expr_comments if dae.__rumoca_emit_expr_comments is defined else false -%}
{%- set eqs = dae.f_x if dae.f_x is defined else (dae.fx if dae.fx is defined else []) -%}
{%- set relation_eqs = dae.relation if dae.relation is defined else [] -%}
{%- set synthetic_root_conditions = dae.synthetic_root_conditions if dae.synthetic_root_conditions is defined else [] -%}
{%- if dae.f_c is defined and dae.f_c|length > 0 -%}
{%- set cond_eqs = dae.f_c -%}
{%- elif relation_eqs|length > 0 -%}
{%- set cond_eqs = relation_eqs -%}
{%- else -%}
{%- set cond_eqs = synthetic_root_conditions -%}
{%- endif -%}
{%- set when_clauses = dae.when_clauses if dae.when_clauses is defined else [] -%}
{%- set reset_eqs = (dae.f_z if dae.f_z is defined else []) + (dae.f_m if dae.f_m is defined else []) -%}

{%- macro render_cref(cr) -%}
{%- if cr.parts is defined -%}
{%- for part in cr.parts -%}{{ part.ident.text }}{{ "." if not loop.last }}{%- endfor -%}
{%- elif cr.ident is defined and cr.ident.text is defined -%}
{{ cr.ident.text }}
{%- elif cr.name is defined -%}
{{ cr.name }}
{%- else -%}
0
{%- endif -%}
{%- endmacro -%}

{%- macro render_symbol_name(value) -%}
{%- if value is string -%}
{{ value }}
{%- elif value is mapping and value.name is defined and value.name is string -%}
{{ value.name }}
{%- elif value is mapping and value.component_ref is defined -%}
{{ render_cref(value.component_ref) }}
{%- elif value is mapping and value.ComponentReference is defined -%}
{{ render_cref(value.ComponentReference) }}
{%- elif value is mapping and value.VarRef is defined and value.VarRef is string -%}
{{ value.VarRef }}
{%- else -%}
{{ value|string }}
{%- endif -%}
{%- endmacro -%}

{%- macro render_varref_name(varref) -%}
{%- if varref is mapping and varref.name is defined -%}
{{ render_symbol_name(varref.name) }}
{%- else -%}
{{ render_symbol_name(varref) }}
{%- endif -%}
{%- endmacro -%}

{%- macro render_varref_first_subscript_index0(varref, mode="safe", symbol_mode="indexed") -%}
{%- set subs = varref.subscripts if varref is mapping and varref.subscripts is defined else [] -%}
{%- if subs|length == 0 -%}0
{%- elif subs[0].Index is defined and subs[0].Index.value is defined -%}
{{ (subs[0].Index.value|int) - 1 }}
{%- elif subs[0].Expr is defined and subs[0].Expr.expr is defined -%}
(({{ render_expr(subs[0].Expr.expr, mode, symbol_mode) }}) - 1)
{%- else -%}0
{%- endif -%}
{%- endmacro -%}

{%- macro js_ident(name) -%}
{{- ('v_' ~ (name|string)
  |replace('.', '__')
  |replace('[', '_')
  |replace(']', '')
  |replace('(', '_')
  |replace(')', '')
  |replace(',', '_')
  |replace(' ', '_')
  |replace('-', '_')
  |replace('/', '_')
  |replace(':', '_')
  |replace(';', '_')
  |replace('*', '_')
  |replace('+', '_')
  |replace('%', '_')
  |replace('>', '_')
  |replace('<', '_')
  |replace('=', '_')
  |replace('!', '_')
  |replace('?', '_')
  |replace('&', '_')
  |replace('|', '_')
  |replace('"', '_')
  |replace("'", '_')) -}}
{%- endmacro -%}

{%- macro render_static_literal(e) -%}
{%- if e is number -%}
{{ e }}
{%- elif e is boolean -%}
{{ "true" if e else "false" }}
{%- elif e is mapping and e.Literal is defined -%}
  {%- set literal = e.Literal.value if e.Literal.value is defined else e.Literal -%}
  {%- if literal.Integer is defined -%}{{ literal.Integer }}
  {%- elif literal.Real is defined -%}{{ literal.Real }}
  {%- elif literal.Bool is defined or literal.Boolean is defined -%}{{ "true" if (literal.Bool if literal.Bool is defined else literal.Boolean) else "false" }}
  {%- else -%}0
  {%- endif -%}
{%- else -%}
0
{%- endif -%}
{%- endmacro -%}

{%- macro comp_start_or_value(comp) -%}
{%- if comp.value is defined -%}
{{ render_static_literal(comp.value) }}
{%- elif comp.start is defined -%}
{{ render_static_literal(comp.start) }}
{%- else -%}
0
{%- endif -%}
{%- endmacro -%}

{%- macro comp_expr_or_value(comp) -%}
{%- if comp.value is defined -%}
{{ render_expr(comp.value) }}
{%- elif comp.start is defined -%}
{{ render_expr(comp.start) }}
{%- else -%}
0
{%- endif -%}
{%- endmacro -%}

{%- macro comp_expr_or_nan(comp) -%}
{%- if comp.value is defined -%}
{{ render_expr(comp.value) }}
{%- elif comp.start is defined and comp.fixed is defined and comp.fixed is not none -%}
{{ render_expr(comp.start) }}
{%- elif comp.start is defined and comp.start is mapping and comp.start.Literal is defined and comp.start.Literal.Real is defined and (comp.start.Literal.Real|string) in ["0", "0.0", "0."] -%}
Number.NaN
{%- elif comp.start is defined and comp.start is mapping and comp.start.Literal is defined and comp.start.Literal.Integer is defined and (comp.start.Literal.Integer|string) == "0" -%}
Number.NaN
{%- elif comp.start is defined -%}
{{ render_expr(comp.start) }}
{%- else -%}
Number.NaN
{%- endif -%}
{%- endmacro -%}

{%- macro inferred_unit_from_name(name) -%}
{%- set __n = (name|string)|trim -%}
{%- set __nl = __n|lower -%}
{%- if __nl == 'i' or __nl[-2:] == '.i' -%}A
{%- elif __nl == 'v' or __nl[-2:] == '.v' -%}V
{%- elif __nl[-7:] == 'q_flow' or __nl[-10:] == '.q_flow' -%}W
{%- elif __nl[-9:] == 'losspower' or __nl[-10:] == '.losspower' -%}W
{%- elif __nl[-9:] == 'r_actual' or __nl[-10:] == '.r_actual' or __nl == 'r' or __nl[-2:] == '.r' -%}Ohm
{%- elif __nl == 'g' or __nl[-2:] == '.g' -%}W/K
{%- elif __nl[-3:] == '.dt' or __nl == 'dt' -%}K
{%- elif __nl == 't' or __nl[-2:] == '.t' -%}K
{%- elif __nl == 'f' or __nl[-2:] == '.f' -%}Hz
{%- elif __nl[-6:] == '.phase' or __nl == 'phase' -%}rad
{%- elif __nl[-6:] == '.omega' or __nl == 'omega' -%}rad/s
{%- elif __nl[-6:] == '.alpha' or __nl == 'alpha' -%}1/K
{%- else -%}
{%- endif -%}
{%- endmacro -%}

{%- macro comp_unit_prop(comp) -%}
{%- if comp.unit is defined and comp.unit is not none -%}
  {%- set __u = (comp.unit|string)|trim -%}
  {%- if __u != '' and __u|lower != 'none' and __u|lower != 'null' -%}
, unit: "{{ __u|replace('\\', '\\\\')|replace('"', '\\"') }}"
  {%- endif -%}
{%- elif comp.displayUnit is defined and comp.displayUnit is not none -%}
  {%- set __u = (comp.displayUnit|string)|trim -%}
  {%- if __u != '' and __u|lower != 'none' and __u|lower != 'null' -%}
, unit: "{{ __u|replace('\\', '\\\\')|replace('"', '\\"') }}"
  {%- endif -%}
{%- elif comp.display_unit is defined and comp.display_unit is not none -%}
  {%- set __u = (comp.display_unit|string)|trim -%}
  {%- if __u != '' and __u|lower != 'none' and __u|lower != 'null' -%}
, unit: "{{ __u|replace('\\', '\\\\')|replace('"', '\\"') }}"
  {%- endif -%}
{%- else -%}
  {%- set __u = inferred_unit_from_name(comp.name if comp.name is defined else '')|trim -%}
  {%- if __u != '' -%}
, unit: "{{ __u|replace('\\', '\\\\')|replace('"', '\\"') }}"
  {%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro render_js_function_name(fname) -%}
{%- set f = render_symbol_name(fname)|trim -%}
{%- set f_norm = f|replace('::', '.') -%}
{%- set f_leaf = f_norm
  |replace('Modelica.Math.', '')
  |replace('Modelica.Blocks.Math.', '')
  |replace('Units.', '')
  |replace('units.', '')
  |replace('SI.Conversions.', '')
  |replace('si.conversions.', '')
  |replace('Conversions.', '')
  |replace('conversions.', '')
  |replace('Math.', '')
-%}
{%- set fl = f_leaf|lower -%}
{%- if fl == "sin" -%}Math.sin
{%- elif fl == "cos" -%}Math.cos
{%- elif fl == "tan" -%}Math.tan
{%- elif fl == "asin" -%}Math.asin
{%- elif fl == "acos" -%}Math.acos
{%- elif fl == "atan" -%}Math.atan
{%- elif fl == "atan2" -%}Math.atan2
{%- elif fl == "sqrt" -%}Math.sqrt
{%- elif fl == "abs" -%}Math.abs
{%- elif fl == "exp" -%}Math.exp
{%- elif fl == "log" -%}Math.log
{%- elif fl == "log10" -%}Math.log10
{%- elif fl == "sinh" -%}Math.sinh
{%- elif fl == "cosh" -%}Math.cosh
{%- elif fl == "tanh" -%}Math.tanh
{%- elif fl == "floor" -%}Math.floor
{%- elif fl == "ceil" -%}Math.ceil
{%- elif fl == "min" -%}Math.min
{%- elif fl == "max" -%}Math.max
{%- else -%}{{ f_leaf }}
{%- endif -%}
{%- endmacro -%}

{%- macro normalize_expr_text(txt) -%}
{{- (txt|string)
  |replace('::', '.')
  |replace('Modelica.Blocks.Math.', 'Math.')
  |replace('Modelica.Math.', 'Math.')
  |replace('Modelica.Units.', '')
  |replace('modelica.units.', '')
  |replace('Units.', '')
  |replace('units.', '')
  |replace('modelica.blocks.math.', 'Math.')
  |replace('modelica.math.', 'Math.')
  |replace('Modelica.Constants.pi', 'Math.PI')
  |replace('Modelica.Constants.e', 'Math.E')
  |replace('modelica.constants.pi', 'Math.PI')
  |replace('modelica.constants.e', 'Math.E')
-}}
{%- endmacro -%}

{%- macro compact_expr_text(expr) -%}
{{- (expr|string)|replace(' ', '')|replace('\n', '')|replace('\r', '')|replace('\t', '') -}}
{%- endmacro -%}

{%- macro is_string_zero_sub(expr) -%}
{%- if expr is string -%}
  {%- set s = compact_expr_text(expr) -%}
  {%- if s.startswith("(0)-(") and s.endswith(")") -%}true{%- else -%}false{%- endif -%}
{%- else -%}
false
{%- endif -%}
{%- endmacro -%}

{%- macro strip_string_zero_sub(expr) -%}
{{ normalize_expr_text(expr)|replace('(0) - (', '(')|replace('(0)-(', '(')|replace('0 - (', '(')|replace('0-(', '(') }}
{%- endmacro -%}

{%- macro safe_symbol_ref_runtime(name) -%}
{%- if name in x_map -%}
X[{%- for (n, _comp) in x_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in y_map -%}
Y[{%- for (n, _comp) in y_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in z_map -%}
Y[{%- for (n, _comp) in z_map|items -%}{%- if n == name -%}{{ y_map|length + loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in m_map -%}
Y[{%- for (n, _comp) in m_map|items -%}{%- if n == name -%}{{ y_map|length + z_map|length + loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in w_map -%}
Y[{%- for (n, _comp) in w_map|items -%}{%- if n == name -%}{{ y_map|length + z_map|length + m_map|length + loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in u_map -%}
U[{%- for (n, _comp) in u_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in p_map -%}
P[{%- for (n, _comp) in p_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in cp_map -%}
constants["{{ name }}"]
{%- else -%}
__rumocaResolveSymbol("{{ name|string|replace('\\', '\\\\')|replace('"', '\\"') }}")
{%- endif -%}
{%- endmacro -%}

{%- macro safe_symbol_ref_safe(name) -%}
{%- if name in x_map -%}
__rumocaReadSymbol("{{ name }}", (typeof X !== "undefined"), ((typeof X !== "undefined") ? X[{%- for (n, _comp) in x_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}] : undefined))
{%- elif name in y_map -%}
__rumocaReadSymbol("{{ name }}", (typeof Y !== "undefined"), ((typeof Y !== "undefined") ? Y[{%- for (n, _comp) in y_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}] : undefined))
{%- elif name in z_map -%}
__rumocaReadSymbol("{{ name }}", (typeof Y !== "undefined"), ((typeof Y !== "undefined") ? Y[{%- for (n, _comp) in z_map|items -%}{%- if n == name -%}{{ y_map|length + loop.index0 }}{%- endif -%}{%- endfor -%}] : undefined))
{%- elif name in m_map -%}
__rumocaReadSymbol("{{ name }}", (typeof Y !== "undefined"), ((typeof Y !== "undefined") ? Y[{%- for (n, _comp) in m_map|items -%}{%- if n == name -%}{{ y_map|length + z_map|length + loop.index0 }}{%- endif -%}{%- endfor -%}] : undefined))
{%- elif name in w_map -%}
__rumocaReadSymbol("{{ name }}", (typeof Y !== "undefined"), ((typeof Y !== "undefined") ? Y[{%- for (n, _comp) in w_map|items -%}{%- if n == name -%}{{ y_map|length + z_map|length + m_map|length + loop.index0 }}{%- endif -%}{%- endfor -%}] : undefined))
{%- elif name in u_map -%}
__rumocaReadSymbol("{{ name }}", (typeof U !== "undefined"), ((typeof U !== "undefined") ? U[{%- for (n, _comp) in u_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}] : undefined))
{%- elif name in p_map -%}
P[{%- for (n, _comp) in p_map|items -%}{%- if n == name -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}]
{%- elif name in cp_map -%}
constants["{{ name }}"]
{%- else -%}
__rumocaResolveSymbol("{{ name|string|replace('\\', '\\\\')|replace('"', '\\"') }}")
{%- endif -%}
{%- endmacro -%}

{%- macro render_symbol_expr(e) -%}
{%- if e is mapping and e.VarRef is defined and e.VarRef.name == "time" -%}
  t
{%- elif e is mapping and e.VarRef is defined -%}
  {{- js_ident(e.VarRef.name) -}}
{%- elif e is mapping and e.ComponentReference is defined and render_cref(e.ComponentReference) == "time" -%}
  t
{%- elif e is mapping and e.ComponentReference is defined -%}
  {{- js_ident(render_cref(e.ComponentReference)) -}}
{%- else -%}
  {{- render_expr(e) -}}
{%- endif -%}
{%- endmacro -%}

{%- macro render_if_condition(cond, mode="safe", symbol_mode="indexed") -%}
{%- if cond is mapping and cond.Array is defined -%}
  {%- set elements = cond.Array.elements if cond.Array.elements is defined else [] -%}
  {%- if elements|length == 0 -%}
  false
  {%- else -%}
  (
    {%- for el in elements -%}
      Boolean({{ render_expr(el, mode, symbol_mode) }}){{ " || " if not loop.last else "" }}
    {%- endfor -%}
  )
  {%- endif -%}
{%- else -%}
  {{ render_expr(cond, mode, symbol_mode) }}
{%- endif -%}
{%- endmacro -%}

{%- macro render_expr(e, mode="safe", symbol_mode="indexed", emit_comment=false, comment_label="") -%}
{%- if emit_comment -%}
/* {{ comment_label }}{{ render_expr(e, mode, "named")|replace('\n', ' ')|replace('\r', ' ') }} */ {{ render_expr(e, mode, symbol_mode) }}
{%- elif e is string -%}
  {{- normalize_expr_text(e) -}}
{%- elif e is number -%}
  {{- e -}}
{%- elif e is boolean -%}
  {{- "true" if e else "false" -}}
{%- elif e is mapping and e.Literal is defined -%}
  {%- set literal = e.Literal.value if e.Literal.value is defined else e.Literal -%}
  {%- if literal.Integer is defined -%}{{ literal.Integer }}
  {%- elif literal.Real is defined -%}{{ literal.Real }}
  {%- elif literal.Bool is defined or literal.Boolean is defined -%}{{ "true" if (literal.Bool if literal.Bool is defined else literal.Boolean) else "false" }}
  {%- elif literal.String is defined -%}"{{ literal.String }}"
  {%- else -%}0{%- endif -%}
{%- elif e is mapping and e.VarRef is defined and render_varref_name(e.VarRef)|trim == "time" -%}
  t
{%- elif e is mapping and e.VarRef is defined and render_varref_name(e.VarRef)|trim == "Modelica.Constants.pi" -%}
  Math.PI
{%- elif e is mapping and e.VarRef is defined and render_varref_name(e.VarRef)|trim == "Modelica.Constants.e" -%}
  Math.E
{%- elif e is mapping and e.VarRef is defined and render_varref_name(e.VarRef)|trim in ["c", "__pre__.c"] and e.VarRef.subscripts is defined and e.VarRef.subscripts|length > 0 -%}
  {%- set varref_name = render_varref_name(e.VarRef)|trim -%}
  {%- set slot_index = render_varref_first_subscript_index0(e.VarRef, mode, symbol_mode)|trim -%}
  {%- if symbol_mode == "named" -%}
    {{ varref_name }}[{{ slot_index }}]
  {%- elif varref_name == "__pre__.c" -%}
    (Array.isArray(cPrev) ? Boolean(cPrev[{{ slot_index }}]) : false)
  {%- else -%}
    (Array.isArray(cCurr) ? Boolean(cCurr[{{ slot_index }}]) : false)
  {%- endif -%}
{%- elif e is mapping and e.VarRef is defined -%}
  {%- set varref_name = render_varref_name(e.VarRef)|trim -%}
  {%- if symbol_mode == "named" -%}
    {{ varref_name }}
  {%- elif varref_name[:8] == "__pre__." -%}
    {%- set current_name = varref_name[8:] -%}
    {%- if mode == "runtime" -%}
      __rumocaPre("{{ current_name }}", {{ safe_symbol_ref_runtime(current_name) }})
    {%- else -%}
      __rumocaPre("{{ current_name }}", {{ safe_symbol_ref_safe(current_name) }})
    {%- endif -%}
  {%- elif mode == "runtime" -%}
    {{- safe_symbol_ref_runtime(varref_name) -}}
  {%- else -%}
    {{- safe_symbol_ref_safe(varref_name) -}}
  {%- endif -%}
{%- elif e is mapping and e.BuiltinCall is defined -%}
  {%- set bc = e.BuiltinCall -%}
  {%- if bc.function|lower == "der" and bc.args|length == 1 -%}
    {%- if symbol_mode == "named" -%}
    der({{ render_expr(bc.args[0], mode, "named") }})
    {%- elif bc.args[0] is mapping and bc.args[0].VarRef is defined and render_varref_name(bc.args[0].VarRef)|trim in x_map -%}
    XDot[{%- for (n, _comp) in x_map|items -%}{%- if n == render_varref_name(bc.args[0].VarRef)|trim -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}]
    {%- elif bc.args[0] is mapping and bc.args[0].ComponentReference is defined and render_cref(bc.args[0].ComponentReference) in x_map -%}
    XDot[{%- for (n, _comp) in x_map|items -%}{%- if n == render_cref(bc.args[0].ComponentReference) -%}{{ loop.index0 }}{%- endif -%}{%- endfor -%}]
    {%- else -%}
    0
    {%- endif -%}
  {%- elif bc.function|lower == "pre" and bc.args|length == 1 -%}
    {%- if bc.args[0] is mapping and bc.args[0].VarRef is defined -%}
    __rumocaPre("{{ render_varref_name(bc.args[0].VarRef)|trim }}", {{ render_expr(bc.args[0], mode, symbol_mode) }})
    {%- elif bc.args[0] is mapping and bc.args[0].ComponentReference is defined -%}
    __rumocaPre("{{ render_cref(bc.args[0].ComponentReference) }}", {{ render_expr(bc.args[0], mode, symbol_mode) }})
    {%- else -%}
    {{ render_expr(bc.args[0], mode, symbol_mode) }}
    {%- endif -%}
  {%- elif bc.function|lower == "edge" and bc.args|length == 1 -%}
    {%- if bc.args[0] is mapping and bc.args[0].VarRef is defined -%}
    __rumocaEdge("{{ render_varref_name(bc.args[0].VarRef)|trim }}", {{ render_expr(bc.args[0], mode, symbol_mode) }})
    {%- elif bc.args[0] is mapping and bc.args[0].ComponentReference is defined -%}
    __rumocaEdge("{{ render_cref(bc.args[0].ComponentReference) }}", {{ render_expr(bc.args[0], mode, symbol_mode) }})
    {%- else -%}
    {{ render_expr(bc.args[0], mode, symbol_mode) }}
    {%- endif -%}
  {%- elif bc.function|lower == "change" and bc.args|length == 1 -%}
    {%- if bc.args[0] is mapping and bc.args[0].VarRef is defined -%}
    __rumocaChange("{{ render_varref_name(bc.args[0].VarRef)|trim }}", {{ render_expr(bc.args[0], mode, symbol_mode) }})
    {%- elif bc.args[0] is mapping and bc.args[0].ComponentReference is defined -%}
    __rumocaChange("{{ render_cref(bc.args[0].ComponentReference) }}", {{ render_expr(bc.args[0], mode, symbol_mode) }})
    {%- else -%}
    {{ render_expr(bc.args[0], mode, symbol_mode) }}
    {%- endif -%}
  {%- elif bc.function|lower == "noevent" and bc.args|length >= 1 -%}
    {{ render_expr(bc.args[0], mode, symbol_mode) }}
  {%- elif bc.function|lower == "homotopy" and bc.args|length >= 1 -%}
    {{ render_expr(bc.args[0], mode, symbol_mode) }}
  {%- elif render_js_function_name(bc.function)|trim|lower == "from_degc" and bc.args|length == 1 -%}
    (({{ render_expr(bc.args[0], mode, symbol_mode) }}) + 273.15)
  {%- elif render_js_function_name(bc.function)|trim|lower == "to_degc" and bc.args|length == 1 -%}
