{
  "name": "taskyon-vscode",
  "displayName": "Taskyon",
  "description": "Use Taskyon inside VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "taskyon",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*",
    "onCommand:taskyon.open",
    "onCommand:taskyon.openExternal"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskyon",
          "title": "Taskyon",
          "icon": "resources/taskyon_mono_opt.svg"
        }
      ]
    },
    "views": {
      "taskyon": [
        {
          "id": "taskyon.sidebar",
          "name": "Taskyon",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "taskyon.open",
        "title": "Taskyon: Open"
      },
      {
        "command": "taskyon.openExternal",
        "title": "Taskyon: Open in Browser"
      }
    ],
    "configuration": {
      "title": "Taskyon",
      "properties": {
        "taskyon.url": {
          "type": "string",
          "default": "https://taskyon.space",
          "description": "Base URL for Taskyon (e.g. https://taskyon.space or http://localhost:9000)."
        },
        "taskyon.openIn": {
          "type": "string",
          "enum": [
            "webview",
            "external"
          ],
          "default": "webview",
          "description": "Default place to open Taskyon when using the Taskyon: Open command."
        }
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@taskyon/taskyon": "workspace:*",
    "@taskyon/tyclient": "workspace:*",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
