{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "types": ["vscode", "node"],
    "baseUrl": "..",
    "paths": {
      "@taskyon/tyclient": ["tyclient/src/index.ts"],
      "@taskyon/taskyon/api": ["taskyon/src/api/index.ts"],
      "@taskyon/shared": ["shared"],
      "@taskyon/shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
