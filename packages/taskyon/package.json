{
  "name": "@taskyon/taskyon",
  "private": true,
  "type": "module",
  "version": "0.5.1",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./browser": {
      "import": "./src/browser.ts"
    },
    "./tools": {
      "import": "./src/tools/index.ts"
    },
    "./tools/*": {
      "import": "./src/tools/*.ts"
    },
    "./db": {
      "import": "./src/db.ts"
    },
    "./api": {
      "import": "./src/api/index.ts"
    },
    "./test-support": {
      "import": "./src/testSupport/storageBackendContract.ts"
    },
    "./documentationManifest": {
      "import": "./src/documentationManifest.ts"
    },
    "./utils/caching": {
      "import": "./src/utils/caching.ts"
    }
  },
  "scripts": {
    "relay": "node ./src/p2p/relay.js"
  },
  "dependencies": {
    "@taskyon/comp-dag": "workspace:*",
    "@huggingface/jinja": "^0.5.6",
    "@taskyon/p2p-core": "workspace:*",
    "ajv": "^8.17.1",
    "ts-pattern": "^5.6.2"
  }
}
