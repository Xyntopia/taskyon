{# -------------------------------------------------------------------------
 # Minimal JS generator for rumoca DAE JSON (implicit form)
 #
 # Model() returns:
 #   - name
 #   - xNames, yNames, uNames, cNames
 #   - pDefaults
 #   - x0, y0
 #   - residual(t, x, xDot, y, u, pOverride) -> residual vector
 #
 # Solver (to be written separately) will:
 #   - choose time-stepping scheme (implicit Euler, BDF, ...)
 #   - treat residual as F(t, x, xDot, y, u, p) = 0
 # ------------------------------------------------------------------------- #}

{%- macro render_expr(e) -%}
  {%- if e is string and e == "Empty" -%}
    0
  {%- elif "Terminal" in e -%}
    {{ e.Terminal.token.text }}
  {%- elif "ComponentReference" in e -%}
    {%- set cr = e.ComponentReference -%}
    {%- for part in cr.parts -%}
      {{ part.ident.text }}{{ "." if not loop.last }}
    {%- endfor -%}
  {%- elif "Unary" in e -%}
    {%- set u = e.Unary -%}
    {%- if "Minus" in u.op -%}
      -({{ render_expr(u.rhs) }})
    {%- elif "Not" in u.op -%}
      !({{ render_expr(u.rhs) }})
    {%- else -%}
      (/* unsupported unary op */ {{ u.op|tojson }} {{ render_expr(u.rhs) }})
    {%- endif -%}
  {%- elif "Binary" in e -%}
    {%- set b = e.Binary -%}
    {%- set op -%}
      {%- if "Add" in b.op -%}+{%- elif "Sub" in b.op -%}-{%- elif "Mul" in b.op -%}*{%- elif "Div" in b.op -%}/{%- elif "Pow" in b.op -%}**{%- elif "LessEq" in b.op -%}<={%- elif "Less" in b.op -%}<{%- elif "GreaterEq" in b.op -%}>={%- elif "Greater" in b.op -%}>{%- elif "Equals" in b.op -%}=== {%- elif "NotEquals" in b.op -%}!=={%- elif "And" in b.op -%}&&{%- elif "Or" in b.op -%}||{%- else -%}?{%- endif -%}
    {%- endset -%}
    ({{ render_expr(b.lhs) }} {{ op }} {{ render_expr(b.rhs) }})
  {%- elif "FunctionCall" in e -%}
    {%- set f = e.FunctionCall -%}
    {%- set name = f.comp.parts[0].ident.text -%}
    {%- if name == "der" and f.args|length == 1 and "ComponentReference" in f.args[0] -%}
      /* der(...) should not appear in RHS after DAE translation */
      der_{{ render_expr(f.args[0]) }}
    {%- elif name == "pre" and f.args|length == 1 and "ComponentReference" in f.args[0] -%}
      /* placeholder: treat pre(x) as x for now */
      {{ render_expr(f.args[0]) }}
    {%- else -%}
      {{ name }}(
      {%- for a in f.args -%}
        {{ render_expr(a) }}{{ ", " if not loop.last }}
      {%- endfor -%}
      )
    {%- endif -%}
  {%- else -%}
    (/* UNKNOWN_EXPR {{ e|tojson }} */ 0)
  {%- endif -%}
{%- endmacro -%}

{%- macro is_derivative_eq(eq) -%}
  {%- if "Simple" in eq and "FunctionCall" in eq.Simple.lhs -%}
    {%- set f = eq.Simple.lhs.FunctionCall -%}
    {%- if f.comp.parts|length == 1 and f.comp.parts[0].ident.text == "der" -%}
      1
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}

{%- macro lhs_state_name(eq) -%}
  {# extract state name from der(state) = ... #}
  {%- set f = eq.Simple.lhs.FunctionCall -%}
  {%- set cr = f.args[0].ComponentReference -%}
  {{ cr.parts[0].ident.text }}
{%- endmacro -%}

/**
 * Generated Modelica DAE model: {{ dae.model_name or "GeneratedModel" }}
 * Implicit form via residual:
 *   F(t, x, xDot, y, u, p) = 0
 */
function Model() {
  "use strict";

  /* --- variable metadata -------------------------------------------------- */

  const xNames = [
  {%- for (name, comp) in dae.x|items %}
    "{{ name }}"{% if not loop.last %},{% endif %}
  {%- endfor %}
  ];

  const uNames = [
  {%- for (name, comp) in dae.u|items %}
    "{{ name }}"{% if not loop.last %},{% endif %}
  {%- endfor %}
  ];

  const yNames = [
  {%- for (name, comp) in dae.y|items %}
    "{{ name }}"{% if not loop.last %},{% endif %}
  {%- endfor %}
  ];

  const cNames = [
  {%- for (name, comp) in dae.c|items %}
    "{{ name }}"{% if not loop.last %},{% endif %}
  {%- endfor %}
  ];

  /* parameters with default values */
  const pDefaults = {
  {%- for (name, comp) in dae.p|items %}
    {{ name }}: {{ render_expr(comp.start) }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  };

  /* initial guesses */
  const x0 = [
  {%- for (name, comp) in dae.x|items %}
    {{ render_expr(comp.start) }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  ];

  const y0 = [
  {%- for (name, comp) in dae.y|items %}
    {{ render_expr(comp.start) }}{% if not loop.last %},{% endif %}
  {%- endfor %}
  ];

  /**
   * Residual function:
   *   F(t, x, xDot, y, u, pOverride) = 0
   *
   * @param {number} t      time
   * @param {number[]} x    state vector
   * @param {number[]} xDot state derivative (chosen by solver)
   * @param {number[]} y    algebraic variables
   * @param {number[]} u    inputs
   * @param {object}  pOverride parameter overrides
   *
   * @returns {number[]} residual vector of length (nx + ny)
   */
  const residual = (t, x, xDot, y, u, pOverride) => {
    const params = Object.assign({}, pDefaults, pOverride || {});

    /* unpack state */
  {%- for (name, comp) in dae.x|items %}
    const {{ name }} = x[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack xDot */
  {%- for (name, comp) in dae.x|items %}
    const {{ name }}_dot = xDot[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack algebraic variables */
  {%- for (name, comp) in dae.y|items %}
    const {{ name }} = y[{{ loop.index0 }}];
  {%- endfor %}

    /* unpack inputs */
  {%- for (name, comp) in dae.u|items %}
    const {{ name }} = u[{{ loop.index0 }}];
  {%- endfor %}

    /* aliases for parameters */
  {%- for (name, comp) in dae.p|items %}
    const {{ name }} = params.{{ name }};
  {%- endfor %}

    const res = new Array({{ dae.x|length + dae.y|length }});
    let k = 0;

    /* --- equations from fx: map to residuals ----------------------------- */
  {%- for eq in dae.fx %}
    {%- if "Simple" in eq %}
      {%- if is_derivative_eq(eq) %}
    // der({{ lhs_state_name(eq) }}) = {{ render_expr(eq.Simple.rhs) }}
    res[k++] = {{ lhs_state_name(eq) }}_dot - ({{ render_expr(eq.Simple.rhs) }});
      {%- else %}
    // {{ render_expr(eq.Simple.lhs) }} = {{ render_expr(eq.Simple.rhs) }}
    res[k++] = ({{ render_expr(eq.Simple.lhs) }}) - ({{ render_expr(eq.Simple.rhs) }});
      {%- endif %}
    {%- else %}
    // unsupported equation form: {{ eq|tojson }}
    // (fill with 0 to preserve vector length if needed)
    // res[k++] = 0;
    {%- endif %}
  {%- endfor %}

    return res;
  };

  return {
    name: "{{ dae.model_name or "GeneratedModel" }}",
    xNames,
    yNames,
    uNames,
    cNames,
    pDefaults,
    x0,
    y0,
    residual
  };
}
