# ───────────────────────────────────────────────────────
# Stage 1: Build Quasar SPA with Node & Yarn
# ───────────────────────────────────────────────────────
FROM ubuntu:24.04 AS frontend

ARG NODE_VERSION=22.x
ENV DEBIAN_FRONTEND=noninteractive \
    YARN_CACHE_FOLDER=/tmp/.yarn-cache \
    NODE_ENV=production

# Step-by-step installation for easier caching
RUN apt-get update
RUN apt-get install -y curl gnupg build-essential ca-certificates
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION} | bash -
RUN apt-get install -y nodejs
RUN npm install -g yarn

WORKDIR /app
COPY package.json yarn.lock ./
RUN --mount=type=cache,target=$YARN_CACHE_FOLDER yarn install --frozen-lockfile

COPY . .
RUN yarn quasar prepare
RUN yarn build

# ───────────────────────────────────────────────────────
# Stage 2: Bundle with Tauri v2 via Yarn (Linux deps per official prerequisites)
# ───────────────────────────────────────────────────────
FROM ubuntu:24.04 AS tauri

ARG NODE_VERSION=22.x
ENV DEBIAN_FRONTEND=noninteractive \
    YARN_CACHE_FOLDER=/tmp/.yarn-cache

# Step-by-step system deps
RUN apt-get update
RUN apt-get install -y curl gnupg wget file build-essential pkg-config ca-certificates
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION} | bash -
RUN apt-get install -y nodejs
RUN npm install -g yarn
RUN apt-get install -y \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    libxdo-dev \
    librsvg2-dev \
    libssl-dev

WORKDIR /app
COPY package.json yarn.lock ./
RUN --mount=type=cache,target=$YARN_CACHE_FOLDER yarn install --frozen-lockfile

COPY --from=frontend /app/dist/spa ./src-tauri/target/release/bundle/
COPY . .

RUN yarn tauri build --release --target linux

# ───────────────────────────────────────────────────────
# Stage 3: Extract artifacts
# ───────────────────────────────────────────────────────
FROM busybox:stable AS artifacts
COPY --from=tauri /app/src-tauri/target/release/bundle/ /out

# Docker Compose (optional separate file):
# version: '3.8'
# services:
#   tauri:
#     build:
#       context: .
#       dockerfile: Dockerfile.tauri
#       target: artifacts
#     volumes:
#       - ./dist-desktop:/out
