# ───────────────────────────────────────────────────────
# Stage 0: Install all JS deps once
# ───────────────────────────────────────────────────────
FROM node:22.10.0 AS deps

# Use a dedicated cache folder for Yarn
ENV YARN_CACHE_FOLDER=/app/.yarn-cache
    #NODE_ENV=production
WORKDIR /app

# Copy lockfiles and install dependencies
COPY package.json yarn.lock /app/
RUN --mount=type=cache,target=$YARN_CACHE_FOLDER yarn install

# ───────────────────────────────────────────────────────
# Stage 1: Build Quasar SPA
# ───────────────────────────────────────────────────────
FROM deps AS frontend
# Copy everything and build
COPY . .
RUN ls node_modules/.bin
RUN ls -la && yarn quasar prepare && yarn build

# ───────────────────────────────────────────────────────
# Stage 2: Bundle with Tauri
# ───────────────────────────────────────────────────────
FROM deps AS tauri
ENV DEBIAN_FRONTEND=noninteractive

# Install native build tools and Tauri prerequisites
RUN apt-get update && \
    apt-get install -y \
      build-essential \
      cmake \
      python3 \
      make \
      g++ \
      libwebkit2gtk-4.1-dev \
      libgtk-3-dev \
      libayatana-appindicator3-dev \
      libxdo-dev \
      librsvg2-dev \
      libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Rust toolchain non‑interactively and source its env immediately
# 1) Mount caches at /tmp/…  
# 2) Install rustup into them  
# 3) Copy into real home dirs
RUN --mount=type=cache,target=/tmp/cargo-home \
    --mount=type=cache,target=/tmp/rustup-home \
    CARGO_HOME=/tmp/cargo-home RUSTUP_HOME=/tmp/rustup-home \
      curl --proto '=https' --tlsv1.2 https://sh.rustup.rs -sSf \
      | sh -s -- -y \
    && cp -a /tmp/cargo-home /root/.cargo \
    && cp -a /tmp/rustup-home /root/.rustup

# Make sure cargo/bin stays on PATH for every subsequent RUN
ENV PATH="/root/.cargo/bin:${PATH}"
ENV HOME="/root"

WORKDIR /app
# Bring in the built SPA and shared node_modules

# Copy the rest of your Tauri sources
COPY . .

# swhich oftena already contains the built SPA 
COPY --from=frontend /app/dist/spa /app/dist/spa

# Build the Tauri bundle
RUN yarn tauri build

# ───────────────────────────────────────────────────────
# Stage 3: Extract artifacts
# ───────────────────────────────────────────────────────
FROM scratch AS export
COPY --from=tauri /app/src-tauri/target/release/bundle/ /bundle
