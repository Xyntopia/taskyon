{
  "name": "taskyon",
  "version": "0.5.3",
  "private": true,
  "description": "Taskyon App",
  "author": "thomas meschede / yeus <thomas.meschede@web.de>",
  "type": "module",
  "workspaces": [
    "packages/https_tunnel_wasm",
    "packages/p2p-core",
    "packages/relay",
    "packages/secure-tunnel",
    "packages/shared",
    "packages/taskyon",
    "packages/taskyon-headless",
    "packages/taskyon-vscode",
    "packages/tycli",
    "packages/tyclient"
  ],
  "scripts": {
    "build": "yarn pack:tyclient && yarn build:app",
    "build:app": "yarn run quasar build",
    "build:app:diagnostics": "TASKYON_FAST_DEV_BUILD=1 yarn run quasar build --debug",
    "build:desktop": "docker build --file Dockerfile --target export --output type=local,dest=./dist-desktop .",
    "build:tauri:headless": "docker build --file Dockerfile --target tauri-headless-runtime -t xyntopia/taskyon-headless .",
    "build:tyclient": "echo 'build client library' && yarn workspace @taskyon/tyclient run build",
    "modelica:libraries:publish": "node ./packages/shared/modelica/scripts/ensure-msl.mjs",
    "modelica:libraries:manifest": "node ./packages/shared/modelica/scripts/ensure-msl.mjs --no-upload",
    "modelica:cli": "node ./packages/shared/modelica/modelica_cli.mjs",
    "diagnostics:modelica:node": "yarn workspace @taskyon/taskyon-headless run diagnostics:modelica",
    "modelica:compare": "node ./packages/shared/modelica/modelica_compare_cli.mjs run --compile-workers 4",
    "modelica:compare:native": "node ./packages/shared/modelica/modelica_compare_cli.mjs run --compile-workers 4 --rumoca-runtime native",
    "modelica:trace-compare": "node ./packages/shared/modelica/modelica_compare_cli.mjs run",
    "modelica:trace-compare:random20": "node ./packages/shared/modelica/modelica_compare_cli.mjs run --max-models 20 --mode random-stop",
    "modelica:baseline:diff": "node ./packages/shared/modelica/modelica_compare_cli.mjs baseline-diff",
    "modelica:baseline:diff:native": "node ./packages/shared/modelica/modelica_compare_cli.mjs baseline-diff --candidate-file packages/shared/modelica/compare/run_latest_msl_native.json",
    "modelica:baseline:update": "node ./packages/shared/modelica/modelica_compare_cli.mjs baseline-update",
    "modelica:baseline:update:native": "node ./packages/shared/modelica/modelica_compare_cli.mjs baseline-update --candidate-file packages/shared/modelica/compare/run_latest_msl_native.json",
    "pack:tyclient": "mkdir -p public/lib && yarn workspace @taskyon/tyclient pack --filename ../../public/lib/tyclient-$npm_package_version.tgz && cp packages/tyclient/dist/tyclient.* public/lib/",
    "dev": "yarn run quasar dev",
    "dev:http": "TASKYON_HTTP=1 yarn run quasar dev",
    "format": "prettier --write \"**/*.{js,ts,vue,,html,md,json}\" --ignore-path .prettierignore",
    "format:file": "prettier --write --ignore-path .prettierignore",
    "lint:fix": "eslint -c ./eslint.config.js './src*/**/*.{ts,js,cjs,mjs,vue}' './packages/**/*.{ts,js,cjs,mjs,vue}' --fix",
    "lint": "vue-tsc --noEmit && eslint -c ./eslint.config.js './src*/**/*.{ts,js,cjs,mjs,vue}' './packages/**/*.{ts,js,cjs,mjs,vue}'",
    "relay": "yarn workspace @taskyon/relay start",
    "tauri:dev": "tauri dev",
    "tauri:dev:headless": "tauri dev -- -- --headless",
    "tauri:dev:headless:xvfb": "bash ./scripts/run-with-xvfb.sh tauri dev -- -- --headless",
    "tauri:dev:headless:all-logs": "tauri dev -- -- --headless --all-logs",
    "tauri:dev:headless:all-logs:xvfb": "bash ./scripts/run-with-xvfb.sh tauri dev -- -- --headless --all-logs",
    "tauri:dev:diagnostics": "yarn build:app:diagnostics && tauri dev -c src-tauri/tauri.diagnostics.conf.json --no-watch -- -- --headless --run-diagnostics",
    "tauri:dev:diagnostics:all-logs": "yarn build:app:diagnostics && tauri dev -c src-tauri/tauri.diagnostics.conf.json --no-watch -- -- --headless --run-diagnostics --all-logs",
    "tauri:dev:diagnostics:devserver": "tauri dev -c src-tauri/tauri.diagnostics.devserver.conf.json --no-watch --no-dev-server-wait -- -- --headless --run-diagnostics",
    "tauri:dev:diagnostics:devserver:xvfb": "bash ./scripts/run-with-xvfb.sh tauri dev -c src-tauri/tauri.diagnostics.devserver.conf.json --no-watch --no-dev-server-wait -- -- --headless --run-diagnostics",
    "tauri:dev:diagnostics:devserver:all-logs": "tauri dev -c src-tauri/tauri.diagnostics.devserver.conf.json --no-watch --no-dev-server-wait -- -- --headless --run-diagnostics --all-logs",
    "tauri:dev:diagnostics:devserver:all-logs:xvfb": "bash ./scripts/run-with-xvfb.sh tauri dev -c src-tauri/tauri.diagnostics.devserver.conf.json --no-watch --no-dev-server-wait -- -- --headless --run-diagnostics --all-logs",
    "tauri:dev:diagnostics:devserver:https": "tauri dev -c src-tauri/tauri.diagnostics.devserver.https.conf.json --no-watch --no-dev-server-wait -- -- --headless --run-diagnostics",
    "tauri:dev:diagnostics:devserver:https:all-logs": "tauri dev -c src-tauri/tauri.diagnostics.devserver.https.conf.json --no-watch --no-dev-server-wait -- -- --headless --run-diagnostics --all-logs",
    "tauri:build": "tauri build",
    "tycli:build": "yarn workspace @taskyon/tycli build",
    "tycli:lint": "yarn workspace @taskyon/tycli lint",
    "tycli:typecheck": "yarn workspace @taskyon/tycli typecheck",
    "tycli:prod": "yarn tycli:build && node packages/tycli/dist/cli.cjs",
    "tycli": "yarn workspace @taskyon/tycli dev"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.13",
    "@ai-sdk/openai-compatible": "^2.0.16",
    "@electric-sql/pglite": "0.3.14",
    "@huggingface/transformers": "^4.0.1",
    "@langchain/codemirror-json-schema": "^0.7.9",
    "@mozilla/readability": "^0.5.0",
    "@msgpack/msgpack": "^3.1.2",
    "@noble/ed25519": "^2.1.0",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@quasar/extras": "^1.17.0",
    "@reclaimprotocol/tls": "^0.1.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@scure/bip39": "^1.5.0",
    "@supabase/supabase-js": "^2.39.0",
    "@taskyon/p2p-core": "workspace:*",
    "@taskyon/shared": "workspace:*",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@vueuse/core": "^10.10.0",
    "ai": "^6.0.42",
    "axios": "^1.15.0",
    "comlink": "^4.4.1",
    "html-to-text": "^9.0.5",
    "it-map": "^3.1.4",
    "it-pipe": "^3.0.1",
    "jose": "^6.1.3",
    "js-tiktoken": "^1.0.7",
    "js-yaml": "^4.1.0",
    "lz-string": "^1.5.0",
    "mammoth": "^1.6.0",
    "path": "^0.12.7",
    "pdfjs-dist": "^4.3.136",
    "pinia": "^3.0.1",
    "pyodide": "^0.29.3",
    "quasar": "^2.17.0",
    "stopword": "^2.0.8",
    "uuid": "^11.1.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.0.0",
    "vue-json-pretty": "^2.2.4",
    "vue-router": "^4.0.12",
    "wasmagic": "^1.0.3",
    "wavefunctioncollapse": "^2.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.0.0-beta.20250505T195954"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@intlify/unplugin-vue-i18n": "^11.0.3",
    "@quasar/app-vite": "^2.3.0",
    "@quasar/cli": "^2.5.0",
    "@quasar/icongenie": "^5.0.0",
    "@quasar/quasar-app-extension-testing-e2e-cypress": "^6.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "@tauri-apps/tauricon": "github:tauri-apps/tauricon",
    "@types/html-to-text": "^9.0.4",
    "@types/js-yaml": "^4.0.5",
    "@types/json-schema": "^7.0.15",
    "@types/leaflet": "^1.9.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.5.9",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.5",
    "@types/stopword": "^2.0.3",
    "@types/uuid": "^10.0.0",
    "@types/wicg-file-system-access": "^2023.10.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vue/devtools": "^8.1.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.3.0",
    "autoprefixer": "^10.4.2",
    "cypress": "^15.9.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.14.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "json-schema-to-ts": "^3.1.1",
    "madge": "^8.0.0",
    "openai": "^6.16.0",
    "prettier": "^3.3.3",
    "sort-package-json": "^3.0.0",
    "type-fest": "^4.30.1",
    "typescript": "^5.9.2",
    "vite-bundle-analyzer": "^1.1.0",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-static-copy": "^3.1.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "productName": "Taskyon App",
  "resolutions": {
    "@types/express": "4.17.23",
    "@types/express-serve-static-core": "4.19.6",
    "axios": "^1.15.0"
  },
  "browserslist": [
    "last 4 Chrome versions",
    "last 4 Firefox versions",
    "last 4 Edge versions",
    "last 4 Safari versions",
    "last 4 Android versions",
    "last 4 iOS versions"
  ],
  "packageManager": "yarn@4.16.0"
}
