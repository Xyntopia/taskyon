{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "headless"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        "https://*:*",
        "http://*:*"
      ]
    },
    "allow-device-open",
    "allow-device-open-session",
    "allow-device-import-session",
    "allow-device-close",
    "allow-request-tauri-storage-reset",
    "allow-tauri-workspace-list-files",
    "allow-tauri-workspace-read-files",
    "allow-tauri-workspace-write-file",
    "allow-tauri-run-bash-command",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-rename",
    "fs:allow-exists"
  ]
}
