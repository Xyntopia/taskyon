{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "headless"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        "https://*:*",
        "http://*:*"
      ]
    }
  ]
}
